{{ 'related-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'related-products.js' | asset_url }}" defer="defer"></script>

<section class="sp-related sp-section" data-related-products data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width section-spacing">
      <header class="sp-section-head" data-sp-reveal>
        <div>
          <p class="sp-kicker">{{ section.settings.eyebrow | escape }}</p>
          <h2 class="sp-section-title">{{ section.settings.heading | newline_to_br }}</h2>
        </div>
        <p class="sp-related__copy">{{ section.settings.copy | escape }}</p>
      </header>
      <div class="sp-related__grid">
        {%- for recommendation in recommendations.products -%}
          {%- render 'product-card', product: recommendation, heading_tag: 'h3', image_loading: 'lazy', fetch_priority: 'auto', image_sizes: '(min-width: 1000px) 25vw, (min-width: 750px) 33vw, 50vw', show_vendor: true, show_secondary_image: true, show_badges: true -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name":"More like this",
  "tag":"section",
  "class":"sp-related-section",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"More from Paradise"},
    {"type":"textarea","id":"heading","label":"Heading","default":"MORE LIKE\nTHIS."},
    {"type":"textarea","id":"copy","label":"Copy","default":"Related pieces selected from current Sole Paradise inventory."},
    {"type":"range","id":"limit","label":"Products","min":2,"max":8,"step":1,"default":4}
  ],
  "presets":[{"name":"More like this"}]
}
{% endschema %}
