{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign has_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign has_filters = true
  endif
  assign active_filter_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_filter_count = active_filter_count | plus: 1
      endif
    else
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endif
  endfor
-%}

<section class="sp-collection section-spacing" data-collection>
  <div class="page-width">
    <header class="sp-collection__head" data-sp-reveal>
      <div>
        <p class="sp-kicker">Paradise inventory</p>
        <h1 class="sp-section-title">{{ collection.title | escape }}</h1>
      </div>
      <div class="sp-collection__head-copy">
        {%- if collection.description != blank -%}<div class="sp-collection__description rte">{{ collection.description }}</div>{%- endif -%}
        <p class="sp-collection__meta">{{ 'collection.product_count' | t: count: collection.products_count }}</p>
      </div>
    </header>

    <div class="sp-collection__toolbar">
      {%- if has_filters -%}
        <button type="button" class="sp-collection__filter-trigger" data-collection-drawer-open aria-expanded="false" aria-controls="CollectionFilters-{{ section.id }}">Filter{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}</button>
      {%- endif -%}
      <div class="sp-collection__view-label">Pieces</div>
      {%- if section.settings.enable_sorting and collection.sort_options.size > 0 -%}
        <form method="get" action="{{ collection.url }}" class="sp-collection__sort" data-collection-sort>
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}<input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">{%- endfor -%}
          {%- endfor -%}
          <label for="SortBy-{{ section.id }}">Sort</label>
          <select id="SortBy-{{ section.id }}" name="sort_by" data-collection-sort-select>
            {%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}
          </select>
          <noscript><button type="submit">Apply</button></noscript>
        </form>
      {%- endif -%}
    </div>

    {%- if active_filter_count > 0 -%}
      <div class="sp-collection__active">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove | escape }}">{{ value.label | escape }} ×</a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' and (filter.min_value.value != blank or filter.max_value.value != blank) -%}
            <a href="{{ filter.url_to_remove | escape }}">Price ×</a>
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ collection.url }}{% if sort_by != blank %}?sort_by={{ sort_by }}{% endif %}">Clear all</a>
      </div>
    {%- endif -%}

    <div class="sp-collection__layout{% if has_filters %} sp-collection__layout--filters{% endif %}">
      {%- if has_filters -%}
        <aside id="CollectionFilters-{{ section.id }}" class="sp-collection__filters" data-collection-drawer>
          <button type="button" class="sp-collection__filters-backdrop" data-collection-drawer-backdrop aria-label="Close filters"></button>
          <div class="sp-collection__filters-panel" data-collection-drawer-panel>
            <div class="sp-collection__filters-head">
              <h2>Filter the archive</h2>
              <button type="button" data-collection-drawer-close aria-label="Close filters">×</button>
            </div>
            <form method="get" action="{{ collection.url }}">
              {%- if sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ sort_by | escape }}">{%- endif -%}
              {%- render 'collection-filters', collection: collection, section_id: section.id -%}
              <div class="sp-collection__filter-actions"><button type="submit">Apply filters</button><a href="{{ collection.url }}">Reset</a></div>
            </form>
          </div>
        </aside>
      {%- endif -%}

      <div class="sp-collection__results">
        {%- paginate collection.products by section.settings.products_per_page -%}
          {%- if collection.products.size > 0 -%}
            <div class="sp-product-grid sp-product-grid--collection">
              {%- for product in collection.products -%}
                {%- render 'product-card', product: product, collection: collection, heading_tag: 'h2', image_loading: 'lazy', fetch_priority: 'auto', image_sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 50vw', show_vendor: true, show_secondary_image: section.settings.show_secondary_image, show_badges: true -%}
              {%- endfor -%}
            </div>
            {%- render 'pagination', paginate: paginate -%}
          {%- else -%}
            <div class="sp-collection__empty"><h2>No pieces found.</h2><p>Try clearing a filter or browsing the full archive.</p><a class="sp-link" href="{{ collection.url }}">Clear filters</a></div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Collection",
  "settings":[
    {"type":"range","id":"products_per_page","label":"Products per page","min":8,"max":32,"step":4,"default":20},
    {"type":"checkbox","id":"show_secondary_image","label":"Show second image on hover","default":true},
    {"type":"checkbox","id":"enable_filtering","label":"Enable filtering","default":true},
    {"type":"checkbox","id":"enable_sorting","label":"Enable sorting","default":true}
  ],
  "enabled_on":{"templates":["collection"]}
}
{% endschema %}
