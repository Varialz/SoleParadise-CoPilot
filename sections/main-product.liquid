{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign has_variant = false
  if selected_variant != blank
    assign has_variant = true
  endif
  assign is_available = false
  if has_variant and selected_variant.available
    assign is_available = true
  endif
  assign active_media_id = blank
  if selected_variant.featured_media
    assign active_media_id = selected_variant.featured_media.id
  elsif product.featured_media
    assign active_media_id = product.featured_media.id
  elsif product.media.size > 0
    assign active_media_id = product.media.first.id
  endif
  assign has_model = false
  for media in product.media
    if media.media_type == 'model'
      assign has_model = true
      break
    endif
  endfor
-%}
<div class="product page-width section-spacing" data-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url | escape }}" data-error-message="{{ 'products.page.update_error' | t | escape }}">
  <div class="product__layout">
    <div class="product__media-column">{%- render 'product-media-gallery', product: product, active_media_id: active_media_id, section_id: section.id -%}</div>
    <div class="product__info-column">
      {%- if section.settings.show_vendor and product.vendor != blank -%}<p class="product__vendor">{{ product.vendor | escape }}</p>{%- endif -%}
      <h1 class="product__title">{{ product.title | escape }}</h1>
      <div class="product__price" data-product-price>{%- if has_variant -%}{%- render 'product-price', product: product, variant: selected_variant -%}{%- else -%}<p class="price price--unavailable">{{ 'products.page.price_unavailable' | t }}</p>{%- endif -%}</div>
      <p class="product__availability" data-product-availability><span class="visually-hidden">{{ 'products.page.availability' | t }}</span>{%- if is_available -%}<span class="product__availability-state product__availability-state--available">{{ 'products.page.available' | t }}</span>{%- elsif has_variant -%}<span class="product__availability-state product__availability-state--sold-out">{{ 'products.page.sold_out' | t }}</span>{%- else -%}<span class="product__availability-state product__availability-state--unavailable">{{ 'products.page.unavailable' | t }}</span>{%- endif -%}</p>
      <p class="visually-hidden" aria-live="polite" data-product-live-region></p>
      {%- render 'product-variant-picker', product: product, section_id: section.id -%}
      <p class="product__error" role="alert" data-product-error hidden></p>
      {%- render 'product-form', product: product, selected_variant: selected_variant, section_id: section.id, show_quantity: section.settings.show_quantity_selector, show_dynamic_checkout: section.settings.enable_dynamic_checkout -%}
      <div class="product__blocks">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'description' -%}{%- if product.description != blank -%}<div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>{%- endif -%}
            {%- when 'sku' -%}<p class="product__sku" data-product-sku {{ block.shopify_attributes }}>{%- if selected_variant.sku != blank -%}<span class="product__sku-label">{{ 'products.page.sku' | t }}</span> <span class="product__sku-value">{{ selected_variant.sku | escape }}</span>{%- endif -%}</p>
            {%- when 'disclosure' -%}{%- if block.settings.heading != blank and block.settings.content != blank -%}<details class="product__disclosure" {{ block.shopify_attributes }}><summary class="product__disclosure-summary"><span>{{ block.settings.heading | escape }}</span>{%- render 'icon', name: 'chevron-down', size: 16 -%}</summary><div class="product__disclosure-content rte">{{ block.settings.content }}</div></details>{%- endif -%}
            {%- when 'custom_text' -%}{%- if block.settings.content != blank -%}<div class="product__custom-text rte" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>{%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{%- if has_model -%}<script src="{{ 'model-viewer-ui.js' | shopify_asset_url }}" defer="defer"></script>{%- endif -%}
{% schema %}
{
  "name":"Product","tag":"section","class":"product-section",
  "settings":[
    {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":true},
    {"type":"checkbox","id":"show_quantity_selector","label":"Show quantity selector","default":false},
    {"type":"checkbox","id":"enable_dynamic_checkout","label":"Enable dynamic checkout","default":true,"info":"Shows accelerated wallet buttons below Add to cart."}
  ],
  "blocks":[
    {"type":"description","name":"Description","limit":1,"settings":[]},
    {"type":"sku","name":"SKU","limit":1,"settings":[]},
    {"type":"disclosure","name":"Disclosure","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"content","label":"Content"}]},
    {"type":"custom_text","name":"Custom text","settings":[{"type":"richtext","id":"content","label":"Content"}]}
  ],
  "max_blocks":10,
  "default":{"blocks":[{"type":"description"}]},
  "enabled_on":{"templates":["product"]}
}
{% endschema %}
