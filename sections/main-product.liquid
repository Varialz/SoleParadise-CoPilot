{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign has_variant = false
  if selected_variant != blank
    assign has_variant = true
  endif
  assign is_available = false
  if has_variant and selected_variant.available
    assign is_available = true
  endif
  assign active_media_id = blank
  if selected_variant.featured_media
    assign active_media_id = selected_variant.featured_media.id
  elsif product.featured_media
    assign active_media_id = product.featured_media.id
  elsif product.media.size > 0
    assign active_media_id = product.media.first.id
  endif
  assign has_model = false
  for media in product.media
    if media.media_type == 'model'
      assign has_model = true
      break
    endif
  endfor

  assign from_feed = false
  if product.tags contains 'FROM-FEED'
    assign from_feed = true
  endif
  assign item_state = product.metafields.custom.item_state.value | default: product.metafields.custom.item_state
  assign archive_size = product.metafields.custom.size.value | default: product.metafields.custom.size
  assign condition = product.metafields.custom.condition.value | default: product.metafields.custom.condition
  assign flaws = product.metafields.custom.flaws.value | default: product.metafields.custom.flaws
  assign measurements = product.metafields.custom.measurements.value | default: product.metafields.custom.measurements
  assign archive_id = product.metafields.custom.archive_id.value | default: product.metafields.custom.archive_id
  assign instagram_permalink = product.metafields.custom.instagram_permalink.value | default: product.metafields.custom.instagram_permalink
  if archive_size == 0 or archive_size == '0'
    assign archive_size = ''
  endif
  assign has_archive_details = false
  if item_state != blank or archive_size != blank or condition != blank or measurements != blank or flaws != blank
    assign has_archive_details = true
  endif
-%}
<div class="product product--boutique page-width section-spacing{% if from_feed %} product--archive{% endif %}" data-product-section data-sp-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url | escape }}" data-error-message="{{ 'products.page.update_error' | t | escape }}">
  <nav class="product__breadcrumbs" aria-label="Breadcrumb" data-sp-product-reveal>
    <a href="{{ routes.root_url }}">Home</a>
    <span>/</span>
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    {%- if product.vendor != blank -%}<span>/</span><span>{{ product.vendor | escape }}</span>{%- endif -%}
  </nav>

  <div class="product__layout">
    <div class="product__media-column" data-sp-product-gallery>
      <div class="product__media-label">
        <span>Documentation</span>
        <span>{{ product.media.size }} media</span>
      </div>
      {%- render 'product-media-gallery', product: product, active_media_id: active_media_id, section_id: section.id -%}
    </div>

    <div class="product__info-column" data-sp-product-info>
      <div class="product__retailer-kicker" data-sp-product-reveal>
        <span>Sole Paradise</span>
        <span>Chicago / Rare goods</span>
      </div>

      {%- if from_feed -%}
        <div class="product__archive-kicker" data-sp-product-reveal>
          <span>From the feed</span>
          {%- if archive_id != blank -%}<span>{{ archive_id | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="product__identity" data-sp-product-reveal>
        {%- if section.settings.show_vendor and product.vendor != blank -%}<p class="product__vendor">{{ product.vendor | escape }}</p>{%- endif -%}
        <h1 class="product__title">{{ product.title | escape }}</h1>
        <div class="product__price" data-product-price>{%- if has_variant -%}{%- render 'product-price', product: product, variant: selected_variant -%}{%- else -%}<p class="price price--unavailable">{{ 'products.page.price_unavailable' | t }}</p>{%- endif -%}</div>

        {%- if item_state != blank or condition != blank -%}
          <div class="product__status-chips" aria-label="Piece status">
            {%- if item_state != blank -%}<span>{{ item_state | escape }}</span>{%- endif -%}
            {%- if condition != blank -%}<span>{{ condition | escape }}</span>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__purchase" data-sp-product-reveal>
        <p class="product__availability" data-product-availability><span class="visually-hidden">{{ 'products.page.availability' | t }}</span>{%- if is_available -%}<span class="product__availability-state product__availability-state--available">{{ 'products.page.available' | t }}</span>{%- elsif has_variant -%}<span class="product__availability-state product__availability-state--sold-out">{{ 'products.page.sold_out' | t }}</span>{%- else -%}<span class="product__availability-state product__availability-state--unavailable">{{ 'products.page.unavailable' | t }}</span>{%- endif -%}</p>
        <p class="visually-hidden" aria-live="polite" data-product-live-region></p>
        {%- render 'product-variant-picker', product: product, section_id: section.id -%}
        <p class="product__error" role="alert" data-product-error hidden></p>
        {%- render 'product-form', product: product, selected_variant: selected_variant, section_id: section.id, show_quantity: section.settings.show_quantity_selector, show_dynamic_checkout: section.settings.enable_dynamic_checkout -%}
      </div>

      <div class="product__pickup" data-product-pickup data-sp-product-reveal>
        <div class="product__pickup-heading">
          {%- render 'icon', name: 'store', size: 19 -%}
          <span>Delivery &amp; pickup</span>
        </div>
        {%- if settings.show_temporary_fulfillment and is_available -%}
          <div class="product__pickup-location">
            <strong>{{ settings.same_day_delivery_text | escape }}</strong>
            <span>Chicago-area delivery — contact the shop after checkout to coordinate.</span>
          </div>
          <div class="product__pickup-location">
            <strong>{{ settings.pickup_today_text | escape }}</strong>
            <span>In-hand at Sole Paradise.</span>
          </div>
          <p class="product__pickup-note">Timing and eligibility must be confirmed with the store.</p>
        {%- else -%}
          <p class="product__pickup-note">Contact Sole Paradise to confirm local availability.</p>
        {%- endif -%}
      </div>

      {%- if from_feed and has_archive_details -%}
        <section class="product__archive-panel" aria-labelledby="ArchiveDetails-{{ section.id }}" data-sp-product-reveal>
          <div class="product__archive-panel-head">
            <p class="sp-kicker">Archive details</p>
            <h2 id="ArchiveDetails-{{ section.id }}">The piece, documented.</h2>
          </div>
          <dl class="product__archive-facts">
            {%- if item_state != blank -%}<div><dt>Item</dt><dd>{{ item_state | escape }}</dd></div>{%- endif -%}
            {%- if archive_size != blank -%}<div><dt>Size</dt><dd>{{ archive_size | escape }}</dd></div>{%- endif -%}
            {%- if condition != blank -%}<div><dt>Condition</dt><dd>{{ condition | escape }}</dd></div>{%- endif -%}
            {%- if measurements != blank -%}<div><dt>Measurements</dt><dd>{{ measurements | escape }}</dd></div>{%- endif -%}
          </dl>
          {%- if flaws != blank -%}
            <div class="product__archive-notes">
              <span>Condition notes</span>
              <p>{{ flaws | escape | newline_to_br }}</p>
            </div>
          {%- endif -%}
          {%- if instagram_permalink != blank -%}
            <a class="sp-link product__instagram-link" href="{{ instagram_permalink | escape }}" target="_blank" rel="noopener">View original Instagram post</a>
          {%- endif -%}
        </section>
      {%- endif -%}

    </div>
  </div>

  <section class="product__details-shell" data-product-tabs data-sp-product-reveal aria-label="Product information">
    <div class="product__tabs" role="tablist" aria-label="Product details">
      <button id="ProductTabDescription-{{ section.id }}" class="product__tab is-active" type="button" role="tab" aria-selected="true" aria-controls="ProductPanelDescription-{{ section.id }}" data-product-tab="description">Description</button>
      <button id="ProductTabAuthenticity-{{ section.id }}" class="product__tab" type="button" role="tab" aria-selected="false" aria-controls="ProductPanelAuthenticity-{{ section.id }}" tabindex="-1" data-product-tab="authenticity">Authenticity guarantee</button>
      <button id="ProductTabFaq-{{ section.id }}" class="product__tab" type="button" role="tab" aria-selected="false" aria-controls="ProductPanelFaq-{{ section.id }}" tabindex="-1" data-product-tab="faq">FAQ</button>
      <button id="ProductTabPayment-{{ section.id }}" class="product__tab" type="button" role="tab" aria-selected="false" aria-controls="ProductPanelPayment-{{ section.id }}" tabindex="-1" data-product-tab="payment">Payments</button>
    </div>

    <div id="ProductPanelDescription-{{ section.id }}" class="product__tab-panel rte" role="tabpanel" aria-labelledby="ProductTabDescription-{{ section.id }}" data-product-tab-panel="description">
      {%- assign description_rendered = false -%}
      {%- assign sku_rendered = false -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'description' -%}<div class="product__description" {{ block.shopify_attributes }}>{%- if product.description != blank -%}{{ product.description }}{%- else -%}<p>Contact Sole Paradise for additional details about this piece.</p>{%- endif -%}</div>{%- assign description_rendered = true -%}
          {%- when 'sku' -%}<p class="product__sku" data-product-sku {{ block.shopify_attributes }}>{%- if selected_variant.sku != blank -%}<span class="product__sku-label">{{ 'products.page.sku' | t }}</span> <span class="product__sku-value">{{ selected_variant.sku | escape }}</span>{%- endif -%}</p>{%- assign sku_rendered = true -%}
        {%- endcase -%}
      {%- endfor -%}
      {%- unless description_rendered -%}<div class="product__description">{%- if product.description != blank -%}{{ product.description }}{%- else -%}<p>Contact Sole Paradise for additional details about this piece.</p>{%- endif -%}</div>{%- endunless -%}
      {%- unless sku_rendered -%}<p class="product__sku" data-product-sku>{%- if selected_variant.sku != blank -%}<span class="product__sku-label">{{ 'products.page.sku' | t }}</span> <span class="product__sku-value">{{ selected_variant.sku | escape }}</span>{%- endif -%}</p>{%- endunless -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'disclosure' -%}{%- if block.settings.heading != blank and block.settings.content != blank -%}<details class="product__disclosure" {{ block.shopify_attributes }}><summary class="product__disclosure-summary"><span>{{ block.settings.heading | escape }}</span>{%- render 'icon', name: 'chevron-down', size: 16 -%}</summary><div class="product__disclosure-content rte">{{ block.settings.content }}</div></details>{%- endif -%}
          {%- when 'custom_text' -%}{%- if block.settings.content != blank -%}<div class="product__custom-text rte" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>{%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div id="ProductPanelAuthenticity-{{ section.id }}" class="product__tab-panel rte" role="tabpanel" aria-labelledby="ProductTabAuthenticity-{{ section.id }}" data-product-tab-panel="authenticity" hidden>{{ section.settings.authenticity_copy }}</div>
    <div id="ProductPanelFaq-{{ section.id }}" class="product__tab-panel rte" role="tabpanel" aria-labelledby="ProductTabFaq-{{ section.id }}" data-product-tab-panel="faq" hidden>{{ section.settings.faq_copy }}</div>
    <div id="ProductPanelPayment-{{ section.id }}" class="product__tab-panel rte" role="tabpanel" aria-labelledby="ProductTabPayment-{{ section.id }}" data-product-tab-panel="payment" hidden>{{ section.settings.payment_copy }}</div>
  </section>

  <div class="product__service-grid" data-sp-product-reveal aria-label="Sole Paradise service standards">
    <div class="product__service-item">{%- render 'icon', name: 'package', size: 25 -%}<strong>Free shipping</strong><span>{{ section.settings.shipping_copy | escape }}</span></div>
    <div class="product__service-item">{%- render 'icon', name: 'phone', size: 25 -%}<strong>Customer service</strong><span>{{ section.settings.service_copy | escape }}</span></div>
    <div class="product__service-item">{%- render 'icon', name: 'lock', size: 25 -%}<strong>Secure payment</strong><span>{{ section.settings.secure_copy | escape }}</span></div>
    <div class="product__service-item">{%- render 'icon', name: 'mail', size: 25 -%}<strong>Contact us</strong>{%- assign contact_email = section.settings.contact_email | default: shop.email -%}{%- if contact_email != blank -%}<a href="mailto:{{ contact_email | escape }}">{{ contact_email | escape }}</a>{%- else -%}<span>Message the Sole Paradise team.</span>{%- endif -%}</div>
  </div>
</div>
{%- if has_model -%}<script src="{{ 'model-viewer-ui.js' | shopify_asset_url }}" defer="defer"></script>{%- endif -%}
{% schema %}
{
  "name":"Product","tag":"section","class":"product-section",
  "settings":[
    {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":true},
    {"type":"checkbox","id":"show_quantity_selector","label":"Show quantity selector","default":false},
    {"type":"checkbox","id":"enable_dynamic_checkout","label":"Enable dynamic checkout","default":true,"info":"Shows accelerated wallet buttons below Add to cart."},
    {"type":"richtext","id":"authenticity_copy","label":"Authenticity guarantee","default":"<p>Every piece is individually inspected by Sole Paradise before it is listed. We stand behind the authenticity of every item we sell.</p>"},
    {"type":"richtext","id":"faq_copy","label":"FAQ","default":"<p>Need measurements, condition details, or help choosing a size? Contact the Sole Paradise team before purchasing and we will help verify the piece.</p>"},
    {"type":"richtext","id":"payment_copy","label":"Payment information","default":"<p>Checkout is encrypted and processed securely through Shopify. Available accelerated and installment options appear at checkout when eligible.</p>"},
    {"type":"text","id":"shipping_copy","label":"Free shipping message","default":"Orders over $250 ship free."},
    {"type":"text","id":"service_copy","label":"Customer service message","default":"Available during store hours for product questions."},
    {"type":"text","id":"secure_copy","label":"Secure payment message","default":"Checkout information is processed securely."},
    {"type":"text","id":"contact_email","label":"Contact email"}
  ],
  "blocks":[
    {"type":"description","name":"Description","limit":1,"settings":[]},
    {"type":"sku","name":"SKU","limit":1,"settings":[]},
    {"type":"disclosure","name":"Disclosure","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"content","label":"Content"}]},
    {"type":"custom_text","name":"Custom text","settings":[{"type":"richtext","id":"content","label":"Content"}]}
  ],
  "max_blocks":10,
  "default":{"blocks":[{"type":"description"}]},
  "enabled_on":{"templates":["product"]}
}
{% endschema %}
