{%- liquid
  assign current_year = 'now' | date: '%Y'
  assign shop_name = shop.name | escape
  assign has_social = false
  if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_tiktok_link != blank
    assign has_social = true
  endif
-%}
<footer class="site-footer" data-footer>
  <div class="site-footer__main page-width">
    {%- if section.settings.show_logo -%}
      <div class="site-footer__brand">
        <a class="site-footer__logo" href="{{ routes.root_url }}">
          {%- if settings.logo -%}
            <img src="{{ settings.logo | image_url: width: settings.logo_width | times: 2 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio }}" loading="lazy">
          {%- else -%}
            <span class="site-footer__wordmark">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="site-footer__blocks">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- assign footer_menu = block.settings.menu -%}
              {%- assign footer_nav_label = block.settings.heading -%}
              {%- if footer_nav_label == blank -%}{%- assign footer_nav_label = 'footer.navigation_fallback' | t -%}{%- endif -%}
              {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
                <div class="footer-block footer-block--menu" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}<h2 class="footer-block__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                  <nav class="footer-block__nav" aria-label="{{ footer_nav_label | escape }}"><ul class="footer-block__list list-unstyled">{%- for link in footer_menu.links -%}<li><a href="{{ link.url | escape }}" class="footer-block__link"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>{%- endfor -%}</ul></nav>
                </div>
              {%- endif -%}

            {%- when 'newsletter' -%}
              {%- assign newsletter_form_id = 'FooterNewsletter-' | append: block.id -%}
              <div class="footer-block footer-block--newsletter" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<h2 class="footer-block__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                {%- if block.settings.text != blank -%}<p class="footer-block__text">{{ block.settings.text | escape | newline_to_br }}</p>{%- endif -%}
                <form
                  id="{{ newsletter_form_id }}"
                  class="footer-newsletter-form"
                  method="post"
                  action="{{ routes.root_url }}contact#{{ newsletter_form_id }}"
                  accept-charset="UTF-8"
                  data-footer-newsletter-form
                  data-success-message="{{ 'footer.newsletter.success' | t | escape }}"
                  data-error-message="{{ 'footer.newsletter.error' | t | escape }}"
                >
                  <input type="hidden" name="form_type" value="customer">
                  <input type="hidden" name="utf8" value="✓">
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <input type="hidden" name="contact[accepts_marketing]" value="true">
                  <div class="field footer-newsletter-form__field">
                    <label class="visually-hidden" for="FooterNewsletter-email-{{ block.id }}">{{ 'footer.newsletter.email_label' | t }}</label>
                    <div class="footer-newsletter-form__row">
                      <input id="FooterNewsletter-email-{{ block.id }}" type="email" name="contact[email]" class="field__input footer-newsletter-form__input" placeholder="{{ 'footer.newsletter.email_placeholder' | t }}" autocomplete="email" autocorrect="off" autocapitalize="off" aria-describedby="FooterNewsletter-status-{{ block.id }}" required>
                      <button type="submit" class="button button--primary footer-newsletter-form__submit" data-footer-newsletter-submit>{{ 'footer.newsletter.submit' | t }}</button>
                    </div>
                    <p id="FooterNewsletter-status-{{ block.id }}" class="footer-newsletter-form__message" role="status" aria-live="polite" data-footer-newsletter-status hidden></p>
                  </div>
                </form>
              </div>

            {%- when 'visit' -%}
              <div class="footer-block footer-block--visit" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<h2 class="footer-block__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                {%- if block.settings.text != blank -%}<div class="footer-block__text">{{ block.settings.text }}</div>{%- endif -%}
                {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}<a href="{{ block.settings.cta_url | escape }}" class="button button--secondary footer-block__cta">{{ block.settings.cta_label | escape }}</a>{%- endif -%}
              </div>

            {%- when 'social' -%}
              {%- if has_social -%}
                <div class="footer-block footer-block--social" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}<h2 class="footer-block__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                  <ul class="footer-social__list list-unstyled">
                    {%- if settings.social_instagram_link != blank -%}<li><a class="footer-social__link" href="{{ settings.social_instagram_link | escape }}" target="_blank" rel="noopener">{%- render 'icon', name: 'instagram' -%}<span class="visually-hidden">{{ 'footer.social.instagram' | t }}</span></a></li>{%- endif -%}
                    {%- if settings.social_facebook_link != blank -%}<li><a class="footer-social__link" href="{{ settings.social_facebook_link | escape }}" target="_blank" rel="noopener">{%- render 'icon', name: 'facebook' -%}<span class="visually-hidden">{{ 'footer.social.facebook' | t }}</span></a></li>{%- endif -%}
                    {%- if settings.social_tiktok_link != blank -%}<li><a class="footer-social__link" href="{{ settings.social_tiktok_link | escape }}" target="_blank" rel="noopener">{%- render 'icon', name: 'tiktok' -%}<span class="visually-hidden">{{ 'footer.social.tiktok' | t }}</span></a></li>{%- endif -%}
                  </ul>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="site-footer__utility page-width">
    {%- capture policy_links -%}{%- for policy in shop.policies -%}{%- if policy != blank and policy.url != blank -%}<li><a href="{{ policy.url | escape }}" class="site-footer__policy-link">{{ policy.title | escape }}</a></li>{%- endif -%}{%- endfor -%}{%- endcapture -%}
    {%- if policy_links != blank -%}<nav class="site-footer__policies" aria-label="{{ 'footer.policies' | t }}"><ul class="site-footer__policies-list list-unstyled">{{ policy_links }}</ul></nav>{%- endif -%}
    <p class="site-footer__copyright text-caption">{{ 'footer.copyright' | t: year: current_year, shop: shop_name }}</p>
  </div>
</footer>

{% schema %}
{
  "name":"Footer",
  "settings":[{"type":"checkbox","id":"show_logo","label":"Show logo","default":true}],
  "blocks":[
    {"type":"menu","name":"Menu","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"link_list","id":"menu","label":"Menu"}]},
    {"type":"newsletter","name":"Newsletter","limit":1,"settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Supporting text"}]},
    {"type":"visit","name":"Visit / Local","limit":1,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Chicago"},{"type":"richtext","id":"text","label":"Supporting text"},{"type":"text","id":"cta_label","label":"Button label"},{"type":"url","id":"cta_url","label":"Button link"}]},
    {"type":"social","name":"Social","limit":1,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Follow us"}]}
  ],
  "max_blocks":8,
  "default":{"blocks":[{"type":"menu","settings":{"heading":"Explore","menu":"footer"}},{"type":"visit","settings":{"heading":"Chicago"}},{"type":"newsletter","settings":{"heading":"Paradise dispatch"}},{"type":"social","settings":{"heading":"Follow us"}}]},
  "enabled_on":{"groups":["footer"]}
}
{% endschema %}
