{%- liquid
  assign menu = section.settings.menu
  assign sticky = section.settings.enable_sticky_header
  assign cart_count = cart.item_count
  assign show_account = false
  if shop.customer_accounts_enabled
    assign show_account = true
  endif
  assign utility_url = section.settings.utility_link
  if utility_url == blank and section.settings.utility_link_label != blank
    assign utility_url = '/pages/sell-to-paradise'
  endif
-%}
{%- if sticky -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: var(--z-index-header);
    }
  {%- endstyle -%}
{%- endif -%}
<header class="site-header" data-header>
  {%- if section.settings.show_utility_bar -%}
    <div class="site-header__utility-bar">
      <div class="page-width site-header__utility-bar-inner">
        <p>{{ section.settings.utility_text | escape }}</p>
        {%- if section.settings.utility_link_label != blank and utility_url != blank -%}
          <a href="{{ utility_url | escape }}">{{ section.settings.utility_link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="site-header__main">
    <div class="site-header__row page-width">
      <button type="button" class="site-header__trigger site-header__trigger--menu no-js-hidden" aria-expanded="false" aria-controls="header-drawer-{{ section.id }}" data-header-drawer-open>
        {%- render 'icon', name: 'menu' -%}
        <span class="visually-hidden">{{ 'header.menu' | t }}</span>
      </button>

      <a class="site-header__logo" href="{{ routes.root_url }}">
        {%- if settings.logo -%}
          <img src="{{ settings.logo | image_url: width: settings.logo_width | times: 2 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio }}" loading="eager">
        {%- else -%}
          <span class="site-header__wordmark">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>

      {%- if menu != blank -%}
        <nav class="header-nav-desktop" aria-label="{{ 'header.primary_navigation' | t }}">
          {%- render 'header-menu-desktop', menu: menu, section_id: section.id -%}
        </nav>
      {%- endif -%}

      <div class="site-header__utility">
        <a class="site-header__trigger site-header__trigger--search" href="{{ routes.search_url }}">{%- render 'icon', name: 'search' -%}<span class="visually-hidden">{{ 'header.search' | t }}</span></a>
        {%- if show_account -%}
          <a class="site-header__trigger site-header__trigger--account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{%- render 'icon', name: 'account' -%}<span class="visually-hidden">{{ 'header.account' | t }}</span></a>
        {%- endif -%}
        <a class="site-header__trigger site-header__trigger--cart" href="{{ routes.cart_url }}" data-header-cart-trigger>
          {%- render 'icon', name: 'bag' -%}
          <span class="visually-hidden">{% if cart_count > 0 %}{{ 'header.cart_count' | t: count: cart_count }}{% else %}{{ 'header.cart' | t }}{% endif %}</span>
          {%- if cart_count > 0 -%}<span class="site-header__cart-count" data-header-cart-count aria-hidden="true">{{ cart_count }}</span>{%- endif -%}
        </a>
      </div>
    </div>
  </div>

  <div id="header-drawer-{{ section.id }}" class="header-drawer" data-header-drawer>
    <div class="header-drawer__backdrop no-js-hidden" data-header-drawer-backdrop></div>
    <div class="header-drawer__panel" aria-label="{{ 'header.menu' | t }}" data-header-drawer-panel>
      <div class="header-drawer__head">
        <span class="header-drawer__brand">{{ shop.name | escape }}</span>
        <button type="button" class="site-header__trigger header-drawer__close no-js-hidden" aria-label="{{ 'header.close_menu' | t }}" data-header-drawer-close>{%- render 'icon', name: 'close' -%}</button>
      </div>
      {%- if menu != blank -%}<nav class="header-drawer__nav" aria-label="{{ 'header.primary_navigation' | t }}">{%- render 'header-menu-mobile', menu: menu, section_id: section.id -%}</nav>{%- endif -%}
      {%- if section.settings.utility_link_label != blank and utility_url != blank -%}
        <div class="header-drawer__seller">
          <a class="header-drawer__seller-link" href="{{ utility_url | escape }}">
            <span>{{ section.settings.utility_link_label | escape }}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      {%- endif -%}
      <div class="header-drawer__footer">
        <span>Chicago based</span>
        <span>Worldwide shipping</span>
      </div>
      {%- if show_account -%}
        <div class="header-drawer__utility"><a class="header-drawer__utility-link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{%- render 'icon', name: 'account' -%}{% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.sign_in' | t }}{% endif %}</a></div>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name":"Header",
  "settings":[
    {"type":"link_list","id":"menu","label":"Primary menu","default":"main-menu"},
    {"type":"checkbox","id":"enable_sticky_header","label":"Enable sticky header","default":true},
    {"type":"checkbox","id":"show_utility_bar","label":"Show utility bar","default":true},
    {"type":"text","id":"utility_text","label":"Utility text","default":"Chicago based · Worldwide shipping · Authenticated"},
    {"type":"text","id":"utility_link_label","label":"Utility link label","default":"Sell to Paradise"},
    {"type":"url","id":"utility_link","label":"Utility link","info":"If blank, Sell to Paradise falls back to /pages/sell-to-paradise."}
  ],
  "enabled_on":{"groups":["header"]}
}
{% endschema %}
