{%- liquid
  assign menu = section.settings.menu
  assign sticky = section.settings.enable_sticky_header
  assign utility_speed = section.settings.utility_speed | default: 24
  assign cart_count = cart.item_count
  assign show_account = false
  if shop.customer_accounts_enabled
    assign show_account = true
  endif
  assign overlay_header = false
  if request.page_type == 'index'
    assign overlay_header = true
  endif
-%}
{%- if sticky -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: var(--z-index-header);
    }
  {%- endstyle -%}
{%- endif -%}
<header class="site-header{% if overlay_header %} site-header--overlay{% endif %}{% unless section.settings.show_utility_bar %} site-header--no-utility{% endunless %}" data-header{% if overlay_header %} data-header-overlay{% endif %}>
  {%- if section.settings.show_utility_bar -%}
    <div class="site-header__utility-bar" role="region" aria-label="Announcement">
      <p class="visually-hidden">{{ section.settings.utility_text | escape }}</p>
      <div class="site-header__utility-bar-inner" aria-hidden="true">
        <div class="site-header__ticker" style="--ticker-duration: {{ utility_speed }}s">
          {%- for ticker_group in (1..2) -%}
            <div class="site-header__ticker-group">
              {%- for ticker_item in (1..4) -%}
                <span class="site-header__ticker-item">{{ section.settings.utility_text | escape }} <span>✦</span></span>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="site-header__main">
    <div class="site-header__row page-width">
      <button type="button" class="site-header__trigger site-header__trigger--menu no-js-hidden" aria-expanded="false" aria-controls="header-drawer-{{ section.id }}" data-header-drawer-open>
        {%- render 'icon', name: 'menu' -%}
        <span class="site-header__utility-label">Menu</span>
        <span class="visually-hidden">{{ 'header.menu' | t }}</span>
      </button>

      <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        {%- if settings.logo -%}
          <img src="{{ settings.logo | image_url: width: settings.logo_width | times: 2 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio }}" loading="eager">
        {%- else -%}
          <span class="site-header__wordmark">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>

      <nav class="header-nav-desktop" aria-label="Primary navigation">
        {%- if menu != blank -%}
          {%- render 'header-menu-desktop', menu: menu, section_id: section.id -%}
        {%- else -%}
          <ul class="header-nav-desktop__list header-nav-desktop__list--fallback list-unstyled">
            <li class="header-nav-desktop__item"><div class="header-nav-desktop__item-row"><a class="header-nav-desktop__link" href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New</a></div></li>
            <li class="header-nav-desktop__item"><div class="header-nav-desktop__item-row"><a class="header-nav-desktop__link" href="{{ routes.all_products_collection_url }}">Shop</a></div></li>
            <li class="header-nav-desktop__item"><div class="header-nav-desktop__item-row"><a class="header-nav-desktop__link" href="{{ routes.collections_url }}">Designers</a></div></li>
            <li class="header-nav-desktop__item"><div class="header-nav-desktop__item-row"><a class="header-nav-desktop__link" href="{{ routes.all_products_collection_url }}?filter.p.product_type=Clothing">Clothing</a></div></li>
            <li class="header-nav-desktop__item"><div class="header-nav-desktop__item-row"><a class="header-nav-desktop__link" href="{{ routes.all_products_collection_url }}?filter.p.product_type=Footwear">Footwear</a></div></li>
            <li class="header-nav-desktop__item"><div class="header-nav-desktop__item-row"><a class="header-nav-desktop__link" href="/pages/contact">Contact</a></div></li>
          </ul>
        {%- endif -%}
      </nav>

      <div class="site-header__utility">
        <a class="site-header__trigger site-header__trigger--search" href="{{ routes.search_url }}">
          {%- render 'icon', name: 'search' -%}
          <span class="site-header__utility-label">Search</span>
          <span class="visually-hidden">{{ 'header.search' | t }}</span>
        </a>
        {%- if show_account -%}
          <a class="site-header__trigger site-header__trigger--account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
            {%- render 'icon', name: 'account' -%}
            <span class="site-header__utility-label">{% if customer %}Account{% else %}Sign in{% endif %}</span>
            <span class="visually-hidden">{{ 'header.account' | t }}</span>
          </a>
        {%- endif -%}
        <a class="site-header__trigger site-header__trigger--cart" href="{{ routes.cart_url }}" data-header-cart-trigger aria-label="Bag, {{ cart_count }} items">
          {%- render 'icon', name: 'bag' -%}
          <span class="site-header__utility-label">Bag</span>
          <span class="visually-hidden">{% if cart_count > 0 %}{{ 'header.cart_count' | t: count: cart_count }}{% else %}{{ 'header.cart' | t }}{% endif %}</span>
          <span class="site-header__cart-count" data-header-cart-count aria-hidden="true">{{ cart_count }}</span>
        </a>
      </div>
    </div>
  </div>

  <div id="header-drawer-{{ section.id }}" class="header-drawer" data-header-drawer>
    <div class="header-drawer__backdrop no-js-hidden" data-header-drawer-backdrop></div>
    <div class="header-drawer__panel" aria-label="{{ 'header.menu' | t }}" data-header-drawer-panel tabindex="-1">
      <div class="header-drawer__head">
        <div class="header-drawer__brand-lockup">
          <img class="header-drawer__mark" src="{{ 'sole-paradise-sp-mark.webp' | asset_url }}" alt="" width="92" height="92" loading="eager">
          <div>
            <span class="header-drawer__eyebrow">Sole Paradise / Chicago</span>
            <span class="header-drawer__brand">{{ shop.name | escape }}</span>
          </div>
        </div>
        <button type="button" class="site-header__trigger header-drawer__close no-js-hidden" aria-label="{{ 'header.close_menu' | t }}" data-header-drawer-close>{%- render 'icon', name: 'close' -%}</button>
      </div>

      <nav class="header-drawer__nav" aria-label="Primary navigation">
        {%- if menu != blank -%}
          {%- render 'header-menu-mobile', menu: menu, section_id: section.id -%}
        {%- else -%}
          <ul class="header-nav-mobile__list header-nav-mobile__list--fallback list-unstyled">
            <li class="header-nav-mobile__item"><div class="header-nav-mobile__row"><a class="header-nav-mobile__link" href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New</a></div></li>
            <li class="header-nav-mobile__item"><div class="header-nav-mobile__row"><a class="header-nav-mobile__link" href="{{ routes.all_products_collection_url }}">Shop</a></div></li>
            <li class="header-nav-mobile__item"><div class="header-nav-mobile__row"><a class="header-nav-mobile__link" href="{{ routes.collections_url }}">Designers</a></div></li>
            <li class="header-nav-mobile__item"><div class="header-nav-mobile__row"><a class="header-nav-mobile__link" href="{{ routes.all_products_collection_url }}?filter.p.product_type=Clothing">Clothing</a></div></li>
            <li class="header-nav-mobile__item"><div class="header-nav-mobile__row"><a class="header-nav-mobile__link" href="{{ routes.all_products_collection_url }}?filter.p.product_type=Footwear">Footwear</a></div></li>
            <li class="header-nav-mobile__item"><div class="header-nav-mobile__row"><a class="header-nav-mobile__link" href="/pages/contact">Contact</a></div></li>
          </ul>
        {%- endif -%}
      </nav>

      <div class="header-drawer__footer">
        <span>Chicago / Illinois</span>
        <span>Authenticated designer resale</span>
        <span>Worldwide shipping</span>
      </div>
      {%- if show_account -%}
        <div class="header-drawer__utility"><a class="header-drawer__utility-link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{%- render 'icon', name: 'account' -%}{% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.sign_in' | t }}{% endif %}</a></div>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name":"Header",
  "settings":[
    {"type":"link_list","id":"menu","label":"Primary menu","default":"main-menu"},
    {"type":"checkbox","id":"enable_sticky_header","label":"Enable sticky header","default":true},
    {"type":"checkbox","id":"show_utility_bar","label":"Show utility bar","default":true},
    {"type":"text","id":"utility_text","label":"Utility text","default":"Chicago / IL · Authenticated designer resale · Worldwide shipping"},
    {"type":"range","id":"utility_speed","label":"Announcement speed","min":12,"max":40,"step":2,"unit":"s","default":24}
  ],
  "enabled_on":{"groups":["header"]}
}
{% endschema %}
