{%- liquid
  assign hero_image = section.settings.image
  assign using_inventory_image = false
  assign fallback_collection = collections['all']
  if hero_image == blank and fallback_collection != blank and fallback_collection.products_count > 0
    assign fallback_product = fallback_collection.products.first
    if fallback_product.featured_image != blank
      assign hero_image = fallback_product.featured_image
      assign using_inventory_image = true
    endif
  endif
-%}
<section class="sp-hero sp-hero--editorial" data-sp-section data-sp-hero>
  <div class="sp-hero__media" data-sp-hero-media>
    {%- if hero_image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w"
            sizes="100vw"
          >
        {%- endif -%}
        {{ hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750,1000,1400,1800,2200,2400', class: 'sp-hero__image', alt: hero_image.alt }}
      </picture>
      {%- if request.design_mode and using_inventory_image -%}<span class="sp-hero__setup">Using the first product image until campaign art is assigned</span>{%- endif -%}
    {%- else -%}
      <div class="sp-hero__fallback" aria-hidden="true"><span>SOLE PARADISE</span><strong>CHICAGO / RARE GOODS</strong></div>
    {%- endif -%}
  </div>
  <div class="sp-hero__veil" aria-hidden="true"></div>

  <div class="sp-hero__inner page-width">
    <div class="sp-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="sp-kicker" data-sp-hero-line>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="sp-display" data-sp-hero-line>{{ section.settings.heading | escape | newline_to_br }}</h1>
      {%- if section.settings.copy != blank -%}<p class="sp-hero__description" data-sp-hero-line>{{ section.settings.copy | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        {%- liquid
          assign hero_url = routes.all_products_collection_url
          if section.settings.button_link != blank
            assign hero_url = section.settings.button_link
          endif
        -%}
        <a class="sp-hero__button" href="{{ hero_url | escape }}" data-sp-hero-line>{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="sp-horizon" data-sp-horizon aria-hidden="true"></div>
  <div class="sp-hero__footer page-width" data-sp-hero-line>
    <span>{{ section.settings.index_label | escape }}</span>
    <span>{{ section.settings.footer_label | escape }}</span>
  </div>
</section>

{% schema %}
{
  "name":"SP — Hero",
  "settings":[
    {"type":"image_picker","id":"image","label":"Campaign image","info":"If blank, the theme borrows the first product image until campaign art is assigned."},
    {"type":"image_picker","id":"mobile_image","label":"Mobile campaign image","info":"Optional portrait crop for phones. Desktop/fallback image is used when blank."},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Curated designer pieces · Updated regularly"},
    {"type":"textarea","id":"heading","label":"Heading","default":"CHICAGO\nTO THE WORLD."},
    {"type":"textarea","id":"copy","label":"Copy","default":"Rare designer, archive and pre-owned pieces selected in Chicago."},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop new arrivals"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"text","id":"index_label","label":"Left footer label","default":"SOLE PARADISE / CHICAGO"},
    {"type":"text","id":"footer_label","label":"Right footer label","default":"WORLDWIDE SHIPPING"}
  ],
  "presets":[{"name":"SP — Hero"}]
}
{% endschema %}
