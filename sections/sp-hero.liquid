<section class="sp-hero" data-sp-section>
  <div class="sp-hero__media" data-sp-parallax>
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 58vw, 100vw', widths: '750,1000,1400,1800,2200', alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'sp-hero__placeholder' }}
    {%- endif -%}
  </div>

  <div class="sp-hero__inner page-width">
    <div class="sp-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="sp-kicker" data-sp-hero-line>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="sp-display" data-sp-hero-line>{{ section.settings.heading | escape | newline_to_br }}</h1>
      {%- if section.settings.copy != blank -%}<p class="sp-hero__description" data-sp-hero-line>{{ section.settings.copy | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}<a class="sp-link" href="{{ section.settings.button_link }}" data-sp-hero-line>{{ section.settings.button_label | escape }}</a>{%- endif -%}
    </div>
  </div>

  <div class="sp-horizon" data-sp-horizon aria-hidden="true"></div>
  {%- if section.settings.index_label != blank -%}<div class="sp-hero__index">{{ section.settings.index_label | escape }}</div>{%- endif -%}
</section>

{% schema %}
{
  "name":"SP — Hero",
  "settings":[
    {"type":"image_picker","id":"image","label":"Campaign image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Chicago — Rare goods"},
    {"type":"textarea","id":"heading","label":"Heading","default":"SOLE\nPARADISE"},
    {"type":"textarea","id":"copy","label":"Copy","default":"Rare designer pieces, landed in Chicago. New arrivals, pre-owned grails and one-off finds."},
    {"type":"text","id":"button_label","label":"Button label","default":"Enter Paradise"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"text","id":"index_label","label":"Corner label","default":"CHICAGO / 001"}
  ],
  "presets":[{"name":"SP — Hero"}]
}
{% endschema %}
