{%- liquid
  assign fallback_image = section.settings.image
  assign using_inventory_image = false
  assign fallback_collection = collections['all']
  if fallback_image == blank and section.blocks.size == 0 and fallback_collection != blank and fallback_collection.products_count > 0
    assign fallback_product = fallback_collection.products.first
    if fallback_product.featured_image != blank
      assign fallback_image = fallback_product.featured_image
      assign using_inventory_image = true
    endif
  endif

  assign default_file_name = section.settings.default_file_name | strip
  assign default_file_image = blank
  if default_file_name != blank
    assign default_file_image = images[default_file_name]
  endif
  assign default_image_url = section.settings.default_image_url | strip
  assign default_hero_url = routes.all_products_collection_url
  if section.settings.button_link != blank
    assign default_hero_url = section.settings.button_link
  endif
-%}
<section
  class="sp-hero sp-hero--editorial sp-hero--slideshow"
  data-sp-section
  data-sp-hero
  data-hero-slideshow
  data-hero-autoplay="{{ section.settings.autoplay }}"
  data-hero-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
  style="--hero-transition: {{ section.settings.transition_speed }}ms"
>
  <div class="sp-hero__media" data-sp-hero-media>
    {%- assign rendered_slides = 0 -%}

    {%- for block in section.blocks -%}
      {%- liquid
        assign block_settings = block.settings
        assign slide_image = block_settings.image
        assign file_name = block_settings.file_name | strip
        assign file_image = blank
        assign slide_url = block_settings.image_url | strip
        assign slide_alt = block_settings.alt | strip
        assign focus_x = block_settings.focus_x | default: 50
        assign focus_y = block_settings.focus_y | default: 55
        assign mobile_focus_x = block_settings.mobile_focus_x | default: 50
        assign mobile_focus_y = block_settings.mobile_focus_y | default: 60
        assign slide_eyebrow = block_settings.eyebrow | default: section.settings.eyebrow
        assign slide_heading = block_settings.heading | default: section.settings.heading
        assign slide_copy = block_settings.copy | default: section.settings.copy
        assign slide_button_label = block_settings.button_label | default: section.settings.button_label
        assign slide_button_url = block_settings.button_link | default: default_hero_url

        if file_name == 'IMG_1341.heic'
          if focus_y == 55
            assign focus_y = 80
          endif
          if mobile_focus_y == 60
            assign mobile_focus_y = 70
          endif
        endif

        if slide_image == blank and file_name != blank
          assign file_image = images[file_name]
        endif

        assign slide_background_url = blank
        if slide_image != blank
          assign slide_background_url = slide_image | image_url: width: 2400
        elsif slide_url != blank
          assign slide_background_url = slide_url
        elsif file_image != blank
          assign slide_background_url = file_image | image_url: width: 2400
        endif

        assign has_slide = false
        if slide_image != blank or file_image != blank or slide_url != blank
          assign has_slide = true
        endif

        if has_slide
          assign slide_loading = 'lazy'
          assign slide_priority = 'low'
          if rendered_slides == 0
            assign slide_loading = 'eager'
            assign slide_priority = 'high'
          endif
          assign rendered_slides = rendered_slides | plus: 1
        endif
      -%}

      {%- if has_slide -%}
        <div
          class="sp-hero__slide{% if rendered_slides == 1 %} is-active{% endif %}"
          data-hero-slide
          data-slide-index="{{ rendered_slides | minus: 1 }}"
          data-hero-eyebrow="{{ slide_eyebrow | escape }}"
          data-hero-heading="{{ slide_heading | escape }}"
          data-hero-copy="{{ slide_copy | escape }}"
          data-hero-button-label="{{ slide_button_label | escape }}"
          data-hero-button-url="{{ slide_button_url }}"
          aria-hidden="{% if rendered_slides == 1 %}false{% else %}true{% endif %}"
          style="--hero-focus-x:{{ focus_x }}%;--hero-focus-y:{{ focus_y }}%;--hero-mobile-focus-x:{{ mobile_focus_x }}%;--hero-mobile-focus-y:{{ mobile_focus_y }}%;{% if slide_background_url != blank %}--hero-image:url({{ slide_background_url | json }});{% endif %}"
          {{ block.shopify_attributes }}
        >
          <picture>
            {%- if block_settings.mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ block_settings.mobile_image | image_url: width: 750 }} 750w, {{ block_settings.mobile_image | image_url: width: 1000 }} 1000w"
                sizes="100vw"
              >
            {%- endif -%}

            {%- if slide_image != blank -%}
              {%- assign resolved_alt = slide_alt | default: slide_image.alt -%}
              {{ slide_image | image_url: width: 2400 | image_tag: loading: slide_loading, fetchpriority: slide_priority, sizes: '100vw', widths: '750,1000,1400,1800,2200,2400', class: 'sp-hero__image', alt: resolved_alt }}
            {%- elsif slide_url != blank -%}
              <img
                class="sp-hero__image"
                src="{{ slide_url | escape }}"
                alt="{{ slide_alt | default: 'Sole Paradise campaign image' | escape }}"
                loading="{{ slide_loading }}"
                fetchpriority="{{ slide_priority }}"
                width="2400"
                height="1600"
              >
            {%- else -%}
              {%- assign resolved_alt = slide_alt | default: file_image.alt -%}
              {{ file_image | image_url: width: 2400 | image_tag: loading: slide_loading, fetchpriority: slide_priority, sizes: '100vw', widths: '750,1000,1400,1800,2200,2400', class: 'sp-hero__image', alt: resolved_alt }}
            {%- endif -%}
          </picture>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if rendered_slides == 0 and default_file_image != blank -%}
      <div class="sp-hero__slide is-active" data-hero-slide data-slide-index="0" aria-hidden="false" style="--hero-focus-x:50%;--hero-focus-y:80%;--hero-mobile-focus-x:50%;--hero-mobile-focus-y:70%">
        <picture>
          {{ default_file_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750,1000,1400,1800,2200,2400', class: 'sp-hero__image', alt: 'Sole Paradise campaign image' }}
        </picture>
      </div>
      {%- assign rendered_slides = 1 -%}
    {%- elsif rendered_slides == 0 and default_image_url != blank -%}
      <div class="sp-hero__slide is-active" data-hero-slide data-slide-index="0" aria-hidden="false" style="--hero-focus-x:50%;--hero-focus-y:80%;--hero-mobile-focus-x:50%;--hero-mobile-focus-y:70%">
        <picture>
          <img
            class="sp-hero__image"
            src="{{ default_image_url | escape }}"
            alt="Sole Paradise campaign image"
            loading="eager"
            fetchpriority="high"
            width="2400"
            height="1600"
          >
        </picture>
      </div>
      {%- assign rendered_slides = 1 -%}
    {%- elsif rendered_slides == 0 and fallback_image != blank -%}
      <div class="sp-hero__slide is-active" data-hero-slide data-slide-index="0" aria-hidden="false">
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w"
              sizes="100vw"
            >
          {%- endif -%}
          {{ fallback_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750,1000,1400,1800,2200,2400', class: 'sp-hero__image', alt: fallback_image.alt }}
        </picture>
      </div>
      {%- assign rendered_slides = 1 -%}
      {%- if request.design_mode and using_inventory_image -%}<span class="sp-hero__setup">Using the first product image until campaign art is assigned</span>{%- endif -%}
    {%- elsif rendered_slides == 0 -%}
      <div class="sp-hero__fallback" aria-hidden="true"><span>SOLE PARADISE</span><strong>CHICAGO / RARE GOODS</strong></div>
    {%- endif -%}
  </div>

  <div class="sp-hero__veil" aria-hidden="true"></div>

  <div class="sp-hero__inner page-width">
    <div class="sp-hero__copy" data-hero-copy-region>
      <p class="sp-kicker" data-sp-hero-line data-hero-eyebrow>{{ section.settings.eyebrow | escape }}</p>
      <h1 class="sp-display" data-sp-hero-line data-hero-heading>{{ section.settings.heading | escape | newline_to_br }}</h1>
      <p class="sp-hero__description" data-sp-hero-line data-hero-description>{{ section.settings.copy | escape }}</p>
      <a class="sp-hero__button" href="{{ default_hero_url }}" data-sp-hero-line data-hero-button>{{ section.settings.button_label | escape }}</a>
    </div>
  </div>

  <div class="sp-horizon" data-sp-horizon aria-hidden="true"></div>
  <div class="sp-hero__footer page-width" data-sp-hero-line>
    <span>{{ section.settings.index_label | escape }}</span>

    {%- if rendered_slides > 1 and section.settings.show_controls -%}
      <div class="sp-hero__slideshow-controls" data-hero-controls aria-label="Hero slideshow controls">
        <button class="sp-hero__slide-control" type="button" data-hero-prev aria-label="Previous slide">←</button>
        <span class="sp-hero__slide-counter" aria-live="polite"><span data-hero-current>01</span> / <span data-hero-total>{{ rendered_slides }}</span></span>
        <button class="sp-hero__slide-control" type="button" data-hero-next aria-label="Next slide">→</button>
        {%- if section.settings.autoplay -%}<button class="sp-hero__slide-toggle" type="button" data-hero-toggle aria-pressed="false">Pause</button>{%- endif -%}
      </div>
    {%- endif -%}

    <span>{{ section.settings.footer_label | escape }}</span>
  </div>
</section>

{% schema %}
{
  "name":"SP — Hero",
  "settings":[
    {"type":"text","id":"default_file_name","label":"Default Shopify Files image","default":"IMG_1341.heic","info":"Fallback only when no campaign slide blocks have usable images."},
    {"type":"text","id":"default_image_url","label":"Default image URL fallback","default":"https://cdn.shopify.com/s/files/1/0859/9561/8554/files/IMG_1341.heic?v=1788568050"},
    {"type":"image_picker","id":"image","label":"Fallback campaign image","info":"Used only when no slideshow/default image can resolve."},
    {"type":"image_picker","id":"mobile_image","label":"Fallback mobile image","info":"Optional portrait crop for the fallback image."},
    {"type":"checkbox","id":"autoplay","label":"Autoplay slideshow","default":true},
    {"type":"range","id":"autoplay_speed","label":"Time per slide","min":4,"max":10,"step":1,"unit":"s","default":6},
    {"type":"range","id":"transition_speed","label":"Fade speed","min":400,"max":1200,"step":100,"unit":"ms","default":700},
    {"type":"checkbox","id":"show_controls","label":"Show slideshow controls","default":true},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Curated designer pieces · Updated regularly"},
    {"type":"textarea","id":"heading","label":"Heading","default":"CHICAGO\nTO THE WORLD."},
    {"type":"textarea","id":"copy","label":"Copy","default":"Rare designer, archive and pre-owned pieces selected in Chicago."},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop new arrivals"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"text","id":"index_label","label":"Left footer label","default":"SOLE PARADISE / CHICAGO"},
    {"type":"text","id":"footer_label","label":"Right footer label","default":"WORLDWIDE SHIPPING"}
  ],
  "blocks":[
    {
      "type":"slide",
      "name":"Campaign slide",
      "settings":[
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"image_picker","id":"mobile_image","label":"Mobile image","info":"Optional phone-specific crop."},
        {"type":"text","id":"file_name","label":"Shopify Files filename","info":"Use the exact filename from Content → Files."},
        {"type":"text","id":"image_url","label":"Fallback CDN URL","info":"Optional fallback when the Files filename cannot resolve."},
        {"type":"header","content":"Slide message"},
        {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Newest restock"},
        {"type":"textarea","id":"heading","label":"Heading","info":"Example: WE ARE RIGHTEOUS"},
        {"type":"textarea","id":"copy","label":"Supporting text","info":"Example: Shop the latest We Are Righteous arrivals."},
        {"type":"text","id":"button_label","label":"Button label","default":"Shop the restock"},
        {"type":"url","id":"button_link","label":"Button link","info":"Link to the matching brand collection or search."},
        {"type":"header","content":"Image position"},
        {"type":"range","id":"focus_x","label":"Desktop focal point — horizontal","min":0,"max":100,"step":5,"unit":"%","default":50},
        {"type":"range","id":"focus_y","label":"Desktop focal point — vertical","min":0,"max":100,"step":5,"unit":"%","default":55},
        {"type":"range","id":"mobile_focus_x","label":"Mobile focal point — horizontal","min":0,"max":100,"step":5,"unit":"%","default":50},
        {"type":"range","id":"mobile_focus_y","label":"Mobile focal point — vertical","min":0,"max":100,"step":5,"unit":"%","default":60},
        {"type":"text","id":"alt","label":"Alt text","default":"Sole Paradise campaign image"}
      ]
    }
  ],
  "max_blocks":8,
  "presets":[{"name":"SP — Hero","blocks":[{"type":"slide"}]}]
}
{% endschema %}
