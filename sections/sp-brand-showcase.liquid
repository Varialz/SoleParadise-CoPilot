{%- assign sp_heading_handle = section.settings.heading | handleize -%}
{%- if sp_heading_handle == 'more-designers' and section.settings.vendor == blank -%}
  {%- render 'dynamic-designers-showcase', section: section -%}
{%- else -%}
<section class="brand-showcase" data-brand-showcase data-section-id="{{ section.id }}">
  <div class="brand-showcase__inner page-width">
    <header class="brand-showcase__header">
      {%- if section.settings.eyebrow != blank -%}<p class="brand-showcase__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="brand-showcase__title">{{ section.settings.heading | escape }}</h2>
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="brand-showcase__tabs" role="tablist" aria-label="Shop {{ section.settings.heading | escape }} by category">
        {%- for block in section.blocks -%}
          {%- assign tab_id = 'BrandShowcaseTab-' | append: section.id | append: '-' | append: block.id -%}
          {%- assign panel_id = 'BrandShowcasePanel-' | append: section.id | append: '-' | append: block.id -%}
          <button
            id="{{ tab_id }}"
            class="brand-showcase__tab{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="{{ panel_id }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-brand-showcase-tab
          >{{ block.settings.label | default: 'All' | escape }}</button>
        {%- endfor -%}
      </div>

      {%- paginate collections.all.products by 250 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign tab_id = 'BrandShowcaseTab-' | append: section.id | append: '-' | append: block.id
            assign panel_id = 'BrandShowcasePanel-' | append: section.id | append: '-' | append: block.id
            assign tab_collection = block.settings.collection
            assign target_vendor = block.settings.vendor | default: section.settings.vendor
            assign target_vendor_handle = target_vendor | handleize
            assign target_category = block.settings.category_match
            assign target_category_handle = target_category | handleize
            assign tab_label_handle = block.settings.label | handleize

            if target_category_handle == blank
              case tab_label_handle
                when 'tees', 'tee', 't-shirts', 't-shirt', 'shirts', 'shirt', 'hoodies', 'hoodie', 'hats', 'hat', 'caps', 'cap', 'accessories', 'accessory', 'clothing', 'apparel', 'footwear', 'shoes', 'sneakers', 'bottoms', 'pants', 'denim', 'outerwear', 'jackets', 'tops'
                  assign target_category_handle = tab_label_handle
              endcase
            endif

            assign products_shown = 0
            assign cta_url = tab_collection.url
            if cta_url == blank and target_vendor != blank
              assign encoded_vendor = target_vendor | url_encode
              assign cta_url = routes.search_url | append: '?type=product&q=' | append: encoded_vendor
            endif
            if cta_url == blank
              assign cta_url = routes.all_products_collection_url
            endif
            assign cta_label = block.settings.button_label
            if cta_label == blank
              assign cta_label = 'Shop all ' | append: block.settings.label
            endif
          -%}
          <div
            id="{{ panel_id }}"
            class="brand-showcase__panel"
            role="tabpanel"
            aria-labelledby="{{ tab_id }}"
            data-brand-showcase-panel
            {{ block.shopify_attributes }}
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="brand-showcase__carousel">
              <button type="button" class="brand-showcase__arrow brand-showcase__arrow--previous" aria-label="Previous products" data-brand-showcase-previous>←</button>
              <div class="brand-showcase__track" data-brand-showcase-track>
                {%- if tab_collection != blank -%}
                  {%- for product in tab_collection.products limit: section.settings.product_limit -%}
                    {%- render 'brand-showcase-card', product: product, brand_label: section.settings.heading -%}
                    {%- assign products_shown = products_shown | plus: 1 -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- for product in collections.all.products -%}
                    {%- liquid
                      assign vendor_matches = true
                      assign category_matches = true

                      assign product_vendor_handle = product.vendor | handleize
                      assign product_title_handle = product.title | handleize
                      assign product_tags_handle = product.tags | join: ' ' | handleize

                      if target_vendor_handle != blank
                        unless product_vendor_handle == target_vendor_handle or product_title_handle contains target_vendor_handle or product_tags_handle contains target_vendor_handle
                          assign vendor_matches = false
                        endunless
                      endif

                      if target_category_handle != blank and target_category_handle != 'all'
                        assign category_matches = false
                        assign product_type_handle = product.type | handleize
                        assign product_title_signal = product.title | downcase | replace: '-', ' ' | replace: '_', ' ' | replace: '/', ' '
                        assign product_type_signal = product.type | downcase | replace: '-', ' ' | replace: '_', ' ' | replace: '/', ' '
                        assign product_tags_signal = product.tags | join: ' ' | downcase | replace: '-', ' ' | replace: '_', ' ' | replace: '/', ' '
                        assign product_taxonomy_signal = ''
                        if product.category != blank
                          assign product_taxonomy_signal = product.category.name | downcase | replace: '-', ' ' | replace: '_', ' ' | replace: '/', ' '
                          for taxonomy_ancestor in product.category.ancestors
                            assign taxonomy_ancestor_name = taxonomy_ancestor.name | downcase | replace: '-', ' ' | replace: '_', ' ' | replace: '/', ' '
                            assign product_taxonomy_signal = product_taxonomy_signal | append: ' ' | append: taxonomy_ancestor_name
                          endfor
                        endif
                        assign catalog_signal = product_title_signal | append: ' ' | append: product_type_signal | append: ' ' | append: product_tags_signal | append: ' ' | append: product_taxonomy_signal | prepend: ' ' | append: ' '

                        case target_category_handle
                          when 'tees', 'tee', 't-shirts', 't-shirt', 'shirts', 'shirt'
                            if product_type_handle contains 'shirt' or product_type_handle contains 'tee' or catalog_signal contains ' t shirt ' or catalog_signal contains ' tshirt ' or catalog_signal contains ' tee ' or catalog_signal contains ' tees ' or catalog_signal contains ' shirt ' or catalog_signal contains ' shirts ' or catalog_signal contains ' short sleeve '
                              assign category_matches = true
                            endif

                          when 'hoodies', 'hoodie', 'sweatshirts', 'sweatshirt', 'crewnecks', 'crewneck'
                            if product_type_handle contains 'hoodie' or product_type_handle contains 'sweatshirt' or product_type_handle contains 'crewneck' or catalog_signal contains ' hoodie ' or catalog_signal contains ' hooded ' or catalog_signal contains ' sweatshirt ' or catalog_signal contains ' crewneck ' or catalog_signal contains ' zip up '
                              assign category_matches = true
                            endif

                          when 'hats', 'hat', 'caps', 'cap', 'headwear'
                            if product_type_handle contains 'hat' or product_type_handle contains 'cap' or product_type_handle contains 'beanie' or catalog_signal contains ' hat ' or catalog_signal contains ' hats ' or catalog_signal contains ' cap ' or catalog_signal contains ' caps ' or catalog_signal contains ' beanie ' or catalog_signal contains ' trucker ' or catalog_signal contains ' snapback ' or catalog_signal contains ' headwear '
                              assign category_matches = true
                            endif

                          when 'accessories', 'accessory'
                            if product_type_handle contains 'accessor' or product_type_handle contains 'bag' or product_type_handle contains 'wallet' or product_type_handle contains 'belt' or product_type_handle contains 'jewel' or product_type_handle contains 'eyewear' or catalog_signal contains ' accessory ' or catalog_signal contains ' accessories ' or catalog_signal contains ' bag ' or catalog_signal contains ' wallet ' or catalog_signal contains ' belt ' or catalog_signal contains ' necklace ' or catalog_signal contains ' bracelet ' or catalog_signal contains ' ring ' or catalog_signal contains ' pendant ' or catalog_signal contains ' chain ' or catalog_signal contains ' sunglasses ' or catalog_signal contains ' glasses ' or catalog_signal contains ' eyewear ' or catalog_signal contains ' keychain ' or catalog_signal contains ' case '
                              assign category_matches = true
                            endif

                          when 'footwear', 'shoes', 'shoe', 'sneakers', 'sneaker'
                            if product_type_handle contains 'shoe' or product_type_handle contains 'sneaker' or product_type_handle contains 'boot' or product_type_handle contains 'slide' or product_type_handle contains 'sandal' or catalog_signal contains ' footwear ' or catalog_signal contains ' shoe ' or catalog_signal contains ' shoes ' or catalog_signal contains ' sneaker ' or catalog_signal contains ' sneakers ' or catalog_signal contains ' boot ' or catalog_signal contains ' boots ' or catalog_signal contains ' slide ' or catalog_signal contains ' slides ' or catalog_signal contains ' sandal ' or catalog_signal contains ' sandals ' or catalog_signal contains ' loafer ' or catalog_signal contains ' loafers ' or catalog_signal contains ' ramones ' or catalog_signal contains ' ramone ' or catalog_signal contains ' geobasket ' or catalog_signal contains ' geobaskets ' or catalog_signal contains ' geth runner ' or catalog_signal contains ' geth runners ' or catalog_signal contains ' mega bumper ' or catalog_signal contains ' bogun ' or catalog_signal contains ' cargobasket ' or catalog_signal contains ' cargo basket ' or catalog_signal contains ' abstract low ' or catalog_signal contains ' abstract high '
                              assign category_matches = true
                            endif

                          when 'bottoms', 'bottom', 'pants', 'pant', 'denim', 'jeans', 'shorts'
                            if product_type_handle contains 'pant' or product_type_handle contains 'denim' or product_type_handle contains 'jean' or product_type_handle contains 'short' or catalog_signal contains ' bottoms ' or catalog_signal contains ' pants ' or catalog_signal contains ' pant ' or catalog_signal contains ' jeans ' or catalog_signal contains ' denim ' or catalog_signal contains ' shorts ' or catalog_signal contains ' trouser ' or catalog_signal contains ' trousers ' or catalog_signal contains ' sweatpants '
                              assign category_matches = true
                            endif

                          when 'outerwear', 'jackets', 'jacket', 'coats', 'coat'
                            if product_type_handle contains 'jacket' or product_type_handle contains 'coat' or product_type_handle contains 'outerwear' or catalog_signal contains ' jacket ' or catalog_signal contains ' jackets ' or catalog_signal contains ' coat ' or catalog_signal contains ' coats ' or catalog_signal contains ' outerwear ' or catalog_signal contains ' puffer ' or catalog_signal contains ' vest '
                              assign category_matches = true
                            endif

                          when 'tops', 'top'
                            if product_type_handle contains 'shirt' or product_type_handle contains 'tee' or product_type_handle contains 'hoodie' or product_type_handle contains 'sweatshirt' or product_type_handle contains 'sweater' or catalog_signal contains ' tops ' or catalog_signal contains ' tee ' or catalog_signal contains ' shirt ' or catalog_signal contains ' hoodie ' or catalog_signal contains ' sweatshirt ' or catalog_signal contains ' sweater ' or catalog_signal contains ' crewneck ' or catalog_signal contains ' jersey '
                              assign category_matches = true
                            endif

                          when 'clothing', 'apparel'
                            if product_type_handle contains 'shirt' or product_type_handle contains 'tee' or product_type_handle contains 'hoodie' or product_type_handle contains 'sweatshirt' or product_type_handle contains 'sweater' or product_type_handle contains 'jacket' or product_type_handle contains 'coat' or product_type_handle contains 'pant' or product_type_handle contains 'denim' or product_type_handle contains 'jean' or product_type_handle contains 'short' or catalog_signal contains ' clothing ' or catalog_signal contains ' apparel ' or catalog_signal contains ' tee ' or catalog_signal contains ' shirt ' or catalog_signal contains ' hoodie ' or catalog_signal contains ' sweatshirt ' or catalog_signal contains ' sweater ' or catalog_signal contains ' jacket ' or catalog_signal contains ' coat ' or catalog_signal contains ' pants ' or catalog_signal contains ' jeans ' or catalog_signal contains ' denim ' or catalog_signal contains ' shorts ' or catalog_signal contains ' trousers ' or catalog_signal contains ' jersey '
                              assign category_matches = true
                            endif

                          else
                            if product_type_handle contains target_category_handle or product_tags_handle contains target_category_handle or product_title_handle contains target_category_handle or catalog_signal contains target_category_handle
                              assign category_matches = true
                            endif
                        endcase
                      endif
                    -%}

                    {%- if vendor_matches and category_matches -%}
                      {%- render 'brand-showcase-card', product: product, brand_label: section.settings.heading -%}
                      {%- assign products_shown = products_shown | plus: 1 -%}
                      {%- if products_shown >= section.settings.product_limit -%}{%- break -%}{%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}

                {%- if products_shown == 0 and request.design_mode -%}
                  <div class="brand-showcase__empty">
                    <div>
                      <p>No products are connected to {{ block.settings.label | default: section.settings.heading | escape }}.</p>
                      <span>The carousel checks Shopify taxonomy, vendor, title, product type and tags. You can still select an exact collection for manual control.</span>
                    </div>
                  </div>
                {%- endif -%}
              </div>
              <button type="button" class="brand-showcase__arrow brand-showcase__arrow--next" aria-label="Next products" data-brand-showcase-next>→</button>
            </div>

            {%- if products_shown > 0 or request.design_mode -%}
              <div class="brand-showcase__cta-wrap">
                <a class="brand-showcase__cta" href="{{ cta_url | escape }}">{{ cta_label | escape }}</a>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name":"SP — Brand carousel",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow"},
    {"type":"text","id":"heading","label":"Brand heading","default":"Chrome Hearts"},
    {"type":"text","id":"vendor","label":"Default Shopify vendor","default":"Chrome Hearts","info":"Used when a tab does not have a collection or its own vendor."},
    {"type":"range","id":"product_limit","label":"Products per tab","min":4,"max":12,"step":1,"default":8}
  ],
  "blocks":[
    {
      "type":"tab",
      "name":"Category / brand tab",
      "limit":8,
      "settings":[
        {"type":"text","id":"label","label":"Tab label","default":"All"},
        {"type":"collection","id":"collection","label":"Collection","info":"Optional exact override. Leave blank to let the carousel classify products automatically."},
        {"type":"text","id":"vendor","label":"Vendor override","info":"Useful when this section is an Other Brands carousel."},
        {"type":"text","id":"category_match","label":"Category to match","info":"Smart matching reads Shopify taxonomy, product title, type and tags. Examples: Tees, Hoodies, Hats, Accessories, Footwear, Bottoms, Outerwear."},
        {"type":"text","id":"button_label","label":"Button label"}
      ]
    }
  ],
  "max_blocks":8,
  "presets":[
    {
      "name":"SP — Brand carousel",
      "blocks":[
        {"type":"tab","settings":{"label":"All"}},
        {"type":"tab","settings":{"label":"Tops","category_match":"Tops"}},
        {"type":"tab","settings":{"label":"Bottoms","category_match":"Bottoms"}},
        {"type":"tab","settings":{"label":"Accessories","category_match":"Accessories"}}
      ]
    }
  ]
}
{% endschema %}
