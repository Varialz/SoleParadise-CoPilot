{{ 'page.css' | asset_url | stylesheet_tag }}

<section class="sp-404">
  <div class="sp-404__inner" data-sp-reveal>
    <span class="sp-404__code">404 / PARADISE LOST</span>
    <h1>NOT ON<br>THE FLOOR.</h1>
    <p>The piece or page you were looking for is no longer here. Browse what is currently available or search the store.</p>
    <div class="sp-404__actions">
      <a class="sp-hero__button" href="{{ routes.all_products_collection_url }}">Shop current pieces</a>
      <a class="sp-404__secondary" href="{{ routes.search_url }}">Search Paradise</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"404",
  "tag":"section",
  "class":"not-found-section",
  "settings":[],
  "enabled_on":{"templates":["404"]}
}
{% endschema %}
