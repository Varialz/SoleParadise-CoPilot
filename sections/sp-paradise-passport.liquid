<section class="sp-passport" id="ParadisePassport-{{ section.id }}">
  <div class="page-width sp-passport__inner">
    <header class="sp-passport__head" data-sp-reveal>
      <div>
        <p class="sp-passport__kicker">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <p>{{ section.settings.copy | escape }}</p>
    </header>

    <div class="sp-passport__grid">
      <article class="sp-passport__card" data-sp-reveal aria-label="Paradise Passport member card preview">
        <div class="sp-passport__card-top">
          <span>SOLE PARADISE / CHICAGO</span>
          <span>PP—001</span>
        </div>
        <div class="sp-passport__mark" aria-hidden="true">SP</div>
        <div class="sp-passport__card-bottom">
          <div><small>MEMBER</small><strong>PARADISE MEMBER</strong></div>
          <div><small>STATUS</small><strong>VISITOR</strong></div>
        </div>
      </article>

      <div class="sp-passport__account" data-sp-reveal>
        <div class="sp-passport__concept">CONCEPT PREVIEW</div>
        <p class="sp-passport__label">YOUR PASSPORT BALANCE</p>
        <p class="sp-passport__balance"><strong>375</strong> Paradise Miles</p>
        <div class="sp-passport__progress" aria-label="375 of 500 miles earned">
          <span style="width: 75%"></span>
        </div>
        <div class="sp-passport__progress-copy"><span>375 MILES</span><span>125 TO $25 REWARD</span></div>
        <button class="sp-passport__button" type="button" disabled>JOIN PARADISE PASSPORT</button>
        <p class="sp-passport__fine">Preview only — enrollment and rewards are not active.</p>
      </div>
    </div>

    <div class="sp-passport__details">
      <div class="sp-passport__panel" data-sp-reveal>
        <p class="sp-passport__label">THE ROUTE TO PARADISE</p>
        <ol class="sp-passport__tiers">
          <li class="is-current"><span>01</span><div><strong>VISITOR</strong><small>0–499 lifetime miles</small></div></li>
          <li><span>02</span><div><strong>RESIDENT</strong><small>500–1,499 lifetime miles</small></div></li>
          <li><span>03</span><div><strong>PARADISE VIP</strong><small>1,500+ lifetime miles</small></div></li>
        </ol>
      </div>

      <div class="sp-passport__panel" data-sp-reveal>
        <p class="sp-passport__label">REWARD EXCHANGE</p>
        <div class="sp-passport__rewards">
          <div><strong>250</strong><span>MILES</span><small>$10 REWARD</small></div>
          <div><strong>500</strong><span>MILES</span><small>$25 REWARD</small></div>
          <div><strong>1,000</strong><span>MILES</span><small>$60 REWARD</small></div>
        </div>
      </div>

      <div class="sp-passport__panel" data-sp-reveal>
        <p class="sp-passport__label">RECENT STAMPS</p>
        <ul class="sp-passport__ledger">
          <li><span>IN-STORE PURCHASE</span><strong>+325</strong></li>
          <li><span>LOCAL PICKUP BONUS</span><strong>+25</strong></li>
          <li><span>PASSPORT CREATED</span><strong>+25</strong></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{% style %}
  #ParadisePassport-{{ section.id }} { background:#020913; color:#f7fbff; border-block:1px solid rgba(115,205,246,.28); }
  #ParadisePassport-{{ section.id }} .sp-passport__inner { padding-top:clamp(64px,8vw,120px); padding-bottom:clamp(64px,8vw,120px); }
  #ParadisePassport-{{ section.id }} .sp-passport__head { display:grid; grid-template-columns:1.25fr .75fr; gap:40px; align-items:end; margin-bottom:48px; }
  #ParadisePassport-{{ section.id }} .sp-passport__kicker,
  #ParadisePassport-{{ section.id }} .sp-passport__label { color:#79cff5; font-size:11px; font-weight:700; letter-spacing:.18em; margin:0 0 13px; }
  #ParadisePassport-{{ section.id }} h2 { color:inherit; font-size:clamp(42px,7vw,92px); font-weight:500; letter-spacing:-.055em; line-height:.88; margin:0; text-transform:uppercase; }
  #ParadisePassport-{{ section.id }} .sp-passport__head > p { color:#aebac7; font-size:16px; line-height:1.65; margin:0; max-width:540px; }
  #ParadisePassport-{{ section.id }} .sp-passport__grid { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr); gap:1px; background:rgba(115,205,246,.23); border:1px solid rgba(115,205,246,.23); }
  #ParadisePassport-{{ section.id }} .sp-passport__card { aspect-ratio:1.65; min-height:340px; padding:30px; position:relative; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; background:radial-gradient(circle at 70% 22%,rgba(126,211,247,.28),transparent 35%),linear-gradient(135deg,#0c3151,#061526 58%,#020913); }
  #ParadisePassport-{{ section.id }} .sp-passport__card:after { content:""; position:absolute; inset:-60%; background:repeating-linear-gradient(115deg,transparent 0 38px,rgba(121,207,245,.045) 39px 40px); transform:rotate(-8deg); pointer-events:none; }
  #ParadisePassport-{{ section.id }} .sp-passport__card-top { display:flex; justify-content:space-between; font-size:10px; font-weight:700; letter-spacing:.16em; z-index:1; }
  #ParadisePassport-{{ section.id }} .sp-passport__mark { align-self:center; border:1px solid rgba(121,207,245,.7); border-radius:50%; color:#79cff5; display:grid; font-size:clamp(48px,7vw,82px); font-weight:600; height:clamp(116px,14vw,170px); place-items:center; transform:rotate(-9deg); width:clamp(116px,14vw,170px); }
  #ParadisePassport-{{ section.id }} .sp-passport__card-bottom { display:flex; justify-content:space-between; gap:24px; z-index:1; }
  #ParadisePassport-{{ section.id }} .sp-passport__card-bottom div:last-child { text-align:right; }
  #ParadisePassport-{{ section.id }} small { color:#8795a4; display:block; font-size:9px; letter-spacing:.14em; }
  #ParadisePassport-{{ section.id }} .sp-passport__card-bottom strong { display:block; font-size:11px; letter-spacing:.12em; margin-top:6px; }
  #ParadisePassport-{{ section.id }} .sp-passport__account { background:#06101c; display:flex; flex-direction:column; justify-content:center; padding:clamp(30px,5vw,70px); }
  #ParadisePassport-{{ section.id }} .sp-passport__concept { align-self:flex-start; border:1px solid #79cff5; color:#79cff5; font-size:9px; letter-spacing:.16em; margin-bottom:42px; padding:8px 10px; }
  #ParadisePassport-{{ section.id }} .sp-passport__balance { margin:0 0 28px; }
  #ParadisePassport-{{ section.id }} .sp-passport__balance strong { display:block; font-size:clamp(54px,7vw,86px); font-weight:400; letter-spacing:-.05em; line-height:.95; }
  #ParadisePassport-{{ section.id }} .sp-passport__progress { background:#172431; height:3px; overflow:hidden; }
  #ParadisePassport-{{ section.id }} .sp-passport__progress span { background:#79cff5; display:block; height:100%; }
  #ParadisePassport-{{ section.id }} .sp-passport__progress-copy { display:flex; justify-content:space-between; color:#7f8c99; font-size:8px; letter-spacing:.12em; margin:10px 0 34px; }
  #ParadisePassport-{{ section.id }} .sp-passport__button { background:#79cff5; border:0; color:#02101d; cursor:not-allowed; font:inherit; font-size:11px; font-weight:700; letter-spacing:.14em; opacity:.86; padding:18px 22px; }
  #ParadisePassport-{{ section.id }} .sp-passport__fine { color:#687786; font-size:10px; margin:12px 0 0; text-align:center; }
  #ParadisePassport-{{ section.id }} .sp-passport__details { display:grid; grid-template-columns:repeat(3,1fr); border:1px solid rgba(115,205,246,.23); border-top:0; }
  #ParadisePassport-{{ section.id }} .sp-passport__panel { min-width:0; padding:30px; }
  #ParadisePassport-{{ section.id }} .sp-passport__panel + .sp-passport__panel { border-left:1px solid rgba(115,205,246,.23); }
  #ParadisePassport-{{ section.id }} .sp-passport__tiers,
  #ParadisePassport-{{ section.id }} .sp-passport__ledger { list-style:none; margin:22px 0 0; padding:0; }
  #ParadisePassport-{{ section.id }} .sp-passport__tiers li { align-items:center; border-top:1px solid #192532; color:#778594; display:flex; gap:14px; padding:14px 0; }
  #ParadisePassport-{{ section.id }} .sp-passport__tiers li.is-current { color:#fff; }
  #ParadisePassport-{{ section.id }} .sp-passport__tiers li > span { color:#79cff5; font-size:9px; }
  #ParadisePassport-{{ section.id }} .sp-passport__tiers strong { font-size:11px; letter-spacing:.1em; }
  #ParadisePassport-{{ section.id }} .sp-passport__tiers small { margin-top:4px; }
  #ParadisePassport-{{ section.id }} .sp-passport__rewards { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:28px; }
  #ParadisePassport-{{ section.id }} .sp-passport__rewards div { background:#091725; padding:18px 8px; text-align:center; }
  #ParadisePassport-{{ section.id }} .sp-passport__rewards strong { display:block; font-size:22px; font-weight:400; }
  #ParadisePassport-{{ section.id }} .sp-passport__rewards span { color:#79cff5; display:block; font-size:7px; letter-spacing:.14em; margin:3px 0 15px; }
  #ParadisePassport-{{ section.id }} .sp-passport__ledger li { border-top:1px solid #192532; display:flex; font-size:10px; justify-content:space-between; letter-spacing:.08em; padding:17px 0; }
  #ParadisePassport-{{ section.id }} .sp-passport__ledger strong { color:#79cff5; }
  @media screen and (max-width: 900px) {
    #ParadisePassport-{{ section.id }} .sp-passport__head, #ParadisePassport-{{ section.id }} .sp-passport__grid { grid-template-columns:1fr; }
    #ParadisePassport-{{ section.id }} .sp-passport__details { grid-template-columns:1fr; }
    #ParadisePassport-{{ section.id }} .sp-passport__panel + .sp-passport__panel { border-left:0; border-top:1px solid rgba(115,205,246,.23); }
  }
  @media screen and (max-width: 560px) {
    #ParadisePassport-{{ section.id }} .sp-passport__head { gap:20px; }
    #ParadisePassport-{{ section.id }} .sp-passport__card { aspect-ratio:auto; min-height:290px; padding:22px; }
    #ParadisePassport-{{ section.id }} .sp-passport__account, #ParadisePassport-{{ section.id }} .sp-passport__panel { padding:24px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Paradise Passport demo",
  "tag": "section",
  "class": "sp-paradise-passport-section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"MEMBERSHIP / REWARDS CONCEPT"},
    {"type":"text","id":"heading","label":"Heading","default":"PARADISE PASSPORT"},
    {"type":"textarea","id":"copy","label":"Copy","default":"A loyalty concept for the people who keep Paradise moving. Earn miles on every purchase, unlock rewards and rise through the ranks."}
  ],
  "presets": [{"name":"Paradise Passport demo"}],
  "enabled_on": {"templates":["index"]}
}
{% endschema %}
