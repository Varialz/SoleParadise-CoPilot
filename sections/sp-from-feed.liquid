{%- liquid
  assign feed_collection = section.settings.collection
  assign using_fallback_collection = false
  if feed_collection == blank
    assign feed_collection = collections['all']
    assign using_fallback_collection = true
  endif
  assign product_limit = section.settings.limit | default: 6
-%}
<section class="sp-section sp-feed sp-feed--media section-spacing" data-sp-feed>
  <div class="page-width">
    <header class="sp-section-head sp-feed__head" data-sp-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="sp-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="sp-section-title">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="sp-feed__intro">
        {%- if section.settings.copy != blank -%}<p>{{ section.settings.copy | escape }}</p>{%- endif -%}
        {%- if section.settings.instagram_url != blank -%}
          <a class="sp-link" href="{{ section.settings.instagram_url | escape }}" target="_blank" rel="noopener">{{ section.settings.instagram_label | escape }}</a>
        {%- endif -%}
      </div>
    </header>

    {%- if feed_collection != blank and feed_collection.products_count > 0 -%}
      {%- if request.design_mode and using_fallback_collection -%}
        <p class="sp-editor-note">Theme setup: showing All products until a dedicated From the Feed collection is selected.</p>
      {%- endif -%}

      {%- if section.settings.enhanced_react_feed -%}
        <div
          data-sp-react-feed
          data-style-url="{{ 'sp-react-feed.css' | asset_url }}"
          hidden
        >
          <script type="application/json" data-sp-react-feed-data>
            {
              "products": [
                {%- for product in feed_collection.products limit: product_limit -%}
                  {%- liquid
                    assign react_size = product.metafields.custom.size.value | default: product.metafields.custom.size
                    assign react_condition = product.metafields.custom.condition.value | default: product.metafields.custom.condition
                    assign react_item_state = product.metafields.custom.item_state.value | default: product.metafields.custom.item_state
                    assign react_archive_id = product.metafields.custom.archive_id.value | default: product.metafields.custom.archive_id
                    assign react_alt = product.featured_image.alt | default: product.title
                  -%}
                  {
                    "title": {{ product.title | json }},
                    "vendor": {{ product.vendor | json }},
                    "url": {{ product.url | json }},
                    "image": {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1400 | json }}{% else %}""{% endif %},
                    "alt": {{ react_alt | json }},
                    "price": {{ product.price | money | json }},
                    "size": {{ react_size | default: '' | json }},
                    "condition": {{ react_condition | default: '' | json }},
                    "itemState": {{ react_item_state | default: '' | json }},
                    "archiveId": {{ react_archive_id | default: '' | json }}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }
          </script>
        </div>
      {%- endif -%}

      <div class="sp-feed-media" data-sp-feed-grid data-sp-feed-fallback>
        {%- for product in feed_collection.products limit: product_limit -%}
          {%- if product.featured_image != blank -%}
            {%- liquid
              assign archive_size = product.metafields.custom.size.value | default: product.metafields.custom.size
              assign condition = product.metafields.custom.condition.value | default: product.metafields.custom.condition
              assign item_state = product.metafields.custom.item_state.value | default: product.metafields.custom.item_state
              assign archive_id = product.metafields.custom.archive_id.value | default: product.metafields.custom.archive_id
              assign tile_alt = product.featured_image.alt | default: product.title
            -%}
            <article class="sp-feed-tile" data-sp-feed-tile>
              <a class="sp-feed-tile__link" href="{{ product.url | escape }}" aria-label="View {{ product.title | escape }}">
                <figure class="sp-feed-tile__media" data-sp-feed-media>
                  {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360,540,720,900,1200', sizes: '(min-width: 1200px) 20vw, (min-width: 750px) 33vw, 50vw', class: 'sp-feed-tile__image', alt: tile_alt }}
                </figure>
                <div class="sp-feed-tile__meta">
                  <div>
                    {%- if product.vendor != blank -%}<span class="sp-feed-tile__vendor">{{ product.vendor | escape }}</span>{%- endif -%}
                    <h3>{{ product.title | escape }}</h3>
                  </div>
                  <div class="sp-feed-tile__price">{%- render 'product-price', product: product -%}</div>
                </div>
              </a>
              <button
                class="sp-feed-tile__quick no-js-hidden"
                type="button"
                data-quick-view-trigger
                data-product-url="{{ product.url | escape }}"
                data-archive="{% if product.tags contains 'FROM-FEED' %}true{% else %}false{% endif %}"
                {% if archive_id != blank %}data-archive-id="{{ archive_id | escape }}"{% endif %}
                {% if archive_size != blank %}data-size="{{ archive_size | escape }}"{% endif %}
                {% if condition != blank %}data-condition="{{ condition | escape }}"{% endif %}
                {% if item_state != blank %}data-item-state="{{ item_state | escape }}"{% endif %}
                aria-label="Quick view {{ product.title | escape }}"
                aria-haspopup="dialog"
                aria-controls="SoleParadiseQuickView"
              >Quick view</button>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_collection_link -%}
        <div class="sp-feed__footer" data-sp-reveal>
          <a class="sp-link" href="{{ feed_collection.url }}">Shop the full feed</a>
        </div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <div class="sp-feed__empty" data-sp-reveal>
        <p>Add products with real photography, then select the automatic <strong>From the Feed</strong> collection in this section.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.enhanced_react_feed -%}
  <script type="module" src="{{ 'sp-react-feed.js' | asset_url }}"></script>
{%- endif -%}

{% style %}
  [data-sp-feed][data-react-feed-mounted='true'] [data-sp-feed-fallback] {
    display: none;
  }
{% endstyle %}

{% schema %}
{
  "name": "From the Feed",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"From the feed"},
    {"type":"text","id":"heading","label":"Heading","default":"Shop the post"},
    {"type":"textarea","id":"copy","label":"Intro","default":"Fresh arrivals, one-offs and details straight from the floor."},
    {"type":"collection","id":"collection","label":"From the Feed collection"},
    {"type":"range","id":"limit","label":"Products to show","min":3,"max":12,"step":1,"default":6},
    {"type":"checkbox","id":"enhanced_react_feed","label":"Use enhanced React lookbook","default":true},
    {"type":"url","id":"instagram_url","label":"Instagram profile URL"},
    {"type":"text","id":"instagram_label","label":"Instagram link label","default":"@soleparadise.chicago"},
    {"type":"checkbox","id":"show_collection_link","label":"Show collection link","default":true}
  ],
  "presets": [{"name":"From the Feed"}]
}
{% endschema %}
