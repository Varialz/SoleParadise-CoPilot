<section class="sp-trust" data-sp-section>
  <div class="page-width sp-trust__grid">
    {%- for block in section.blocks -%}
      <div class="sp-trust__item" data-sp-reveal {{ block.shopify_attributes }}>
        <strong>{{ block.settings.title | escape }}</strong>
        <span>{{ block.settings.text | escape }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name":"SP — Trust Strip",
  "blocks":[{"type":"item","name":"Trust item","settings":[{"type":"text","id":"title","label":"Title","default":"Authenticated"},{"type":"text","id":"text","label":"Text","default":"Every piece inspected before listing"}]}],
  "max_blocks":4,
  "presets":[{"name":"SP — Trust Strip","blocks":[{"type":"item","settings":{"title":"Authenticated","text":"Every piece inspected before listing"}},{"type":"item","settings":{"title":"Limited inventory","text":"When it's gone, it's gone"}},{"type":"item","settings":{"title":"Chicago based","text":"Local pickup and personal service"}},{"type":"item","settings":{"title":"Secure shipping","text":"Rare pieces delivered with care"}}]}]
}
{% endschema %}
