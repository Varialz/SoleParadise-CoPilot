<section class="sp-section sp-brand-index section-spacing" data-sp-section>
  <div class="page-width">
    <div class="sp-section-head" data-sp-reveal>
      <div><p class="sp-kicker">{{ section.settings.eyebrow | escape }}</p><h2 class="sp-section-title">{{ section.settings.heading | escape }}</h2></div>
    </div>
    <div class="sp-brand-index__grid">
      {%- for block in section.blocks -%}
        <a class="sp-brand-index__item" href="{{ block.settings.link }}" data-sp-reveal {{ block.shopify_attributes }}><span>{{ block.settings.name | escape }}</span><span aria-hidden="true">↗</span></a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"SP — Brand Index",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The labels"},
    {"type":"text","id":"heading","label":"Heading","default":"Brands in Paradise"}
  ],
  "blocks":[{"type":"brand","name":"Brand","settings":[{"type":"text","id":"name","label":"Brand name","default":"Chrome Hearts"},{"type":"url","id":"link","label":"Collection link"}]}],
  "max_blocks":24,
  "presets":[{"name":"SP — Brand Index","blocks":[{"type":"brand","settings":{"name":"Chrome Hearts"}},{"type":"brand","settings":{"name":"Rick Owens"}},{"type":"brand","settings":{"name":"Amiri"}},{"type":"brand","settings":{"name":"Balenciaga"}},{"type":"brand","settings":{"name":"Gallery Dept."}},{"type":"brand","settings":{"name":"Saint Mxxxxxx"}}]}]
}
{% endschema %}
