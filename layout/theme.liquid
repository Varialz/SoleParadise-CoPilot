<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    {%- render 'meta-tags' -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    {{ content_for_header }}
    {%- render 'css-variables' -%}
    {%- liquid
      assign font_body_bold = settings.font_body | font_modify: 'weight', 'bold'
      assign font_body_italic = settings.font_body | font_modify: 'style', 'italic'
      assign font_body_bold_italic = font_body_bold | font_modify: 'style', 'italic'
    -%}
    {%- style -%}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ font_body_bold | font_face: font_display: 'swap' }}
      {{ font_body_italic | font_face: font_display: 'swap' }}
      {{ font_body_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
    {%- endstyle -%}
    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'header.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'footer.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'product-card.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'sole-paradise.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'paradise-selects.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'mockup-alignment.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'quick-view.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'seller-portal-launch.css' | asset_url }}">
    {%- if request.page_type == 'collection' -%}<link rel="stylesheet" href="{{ 'collection.css' | asset_url }}">{%- endif -%}
    {%- if request.page_type == 'product' -%}<link rel="stylesheet" href="{{ 'product.css' | asset_url }}">{%- endif -%}
    {%- if settings.favicon -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js" defer="defer"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js" defer="defer"></script>
    <script src="{{ 'sole-paradise-motion.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
    {%- if request.page_type == 'collection' -%}<script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>{%- endif -%}
    {%- if request.page_type == 'product' -%}<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>{%- endif -%}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>
    {%- sections 'header-group' -%}
    <main id="main-content" tabindex="-1">{{ content_for_layout }}</main>
    {%- render 'quick-view-drawer' -%}
    {%- sections 'footer-group' -%}
  </body>
</html>
