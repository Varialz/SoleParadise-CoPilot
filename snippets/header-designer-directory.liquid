{%- style -%}
  .header-drawer__designers--stage{padding:1.05rem 1.15rem 1.2rem}
  .header-drawer__designers--stage .header-drawer__designers-head{margin-bottom:.78rem}
  .header-designer-stage__count{color:rgba(255,255,255,.46);font:700 .5rem/1 monospace;letter-spacing:.085em;text-transform:uppercase;white-space:nowrap}
  .header-designer-stage{position:relative;min-height:330px;overflow:hidden;border:1px solid rgba(126,204,243,.2);background:#041226;color:#fff;isolation:isolate}
  .header-designer-stage::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(4,18,38,.18) 0%,rgba(4,18,38,.54) 43%,rgba(4,18,38,.97) 100%);pointer-events:none}
  .header-designer-stage__media{position:absolute;inset:0;z-index:0;background:#061a38}
  .header-designer-stage__media-item{position:absolute;inset:0;opacity:0;transform:scale(1.045);transition:opacity .34s ease,transform .6s cubic-bezier(.2,.7,.2,1)}
  .header-designer-stage__media-item.is-active{opacity:1;transform:scale(1.01)}
  .header-designer-stage__media-item img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.62) contrast(1.05) brightness(.6)}
  .header-designer-stage__media-fallback{position:absolute;inset:0;display:grid;place-items:center;padding:1rem;color:rgba(255,255,255,.08);font:800 clamp(2.3rem,8vw,4.8rem)/.84 var(--font-heading-family);letter-spacing:-.06em;text-align:center;text-transform:uppercase}
  .header-designer-stage__topline{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.72rem .78rem;color:rgba(255,255,255,.56);font:700 .49rem/1 monospace;letter-spacing:.1em;text-transform:uppercase;border-bottom:1px solid rgba(255,255,255,.1)}
  .header-designer-stage__topline span:first-child{color:var(--sp-paradise)}
  .header-designer-stage__watermark{position:absolute;left:.65rem;right:.65rem;top:3.05rem;z-index:1;overflow:hidden;color:rgba(255,255,255,.065);font:800 clamp(2.7rem,9vw,5.4rem)/.8 var(--font-heading-family);letter-spacing:-.065em;text-transform:uppercase;white-space:nowrap;pointer-events:none}
  .header-designer-stage__reels{position:relative;z-index:3;display:grid;gap:.34rem;padding:1.05rem 0 .72rem;overflow:hidden}
  .header-designer-stage__reel{width:calc(100% + 2.5rem);margin-left:-1.25rem;overflow:hidden;transform:rotate(-1.4deg)}
  .header-designer-stage__reel--reverse{transform:rotate(1.2deg)}
  .header-designer-stage__track{display:flex;align-items:center;width:max-content;animation:sp-designer-stage-marquee 20s linear infinite;will-change:transform}
  .header-designer-stage__reel--reverse .header-designer-stage__track{animation-direction:reverse;animation-duration:24s}
  .header-designer-stage:hover .header-designer-stage__track,.header-designer-stage:focus-within .header-designer-stage__track{animation-play-state:paused}
  .header-designer-stage__brand{appearance:none;display:inline-flex;align-items:center;flex:0 0 auto;min-height:42px;padding:.2rem .62rem;background:transparent!important;border:0!important;border-radius:0!important;box-shadow:none!important;color:rgba(255,255,255,.58)!important;font:800 clamp(.92rem,2.6vw,1.3rem)/1 var(--font-heading-family);letter-spacing:-.025em;text-transform:uppercase;white-space:nowrap;cursor:pointer;transition:color .18s ease,transform .18s ease,text-shadow .18s ease}
  .header-designer-stage__brand::after{content:"•";margin-left:1.2rem;color:rgba(126,204,243,.42);font-size:.7rem}
  .header-designer-stage__brand:hover,.header-designer-stage__brand:focus-visible,.header-designer-stage__brand.is-active{color:#fff!important;transform:translateY(-1px);text-shadow:0 0 18px rgba(126,204,243,.22)}
  .header-designer-stage__brand.is-active{color:var(--sp-paradise)!important}
  .header-designer-stage__selected{position:relative;z-index:3;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:1rem;margin:.15rem .78rem 0;padding:.8rem 0 .74rem;border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.12)}
  .header-designer-stage__eyebrow{display:block;margin-bottom:.28rem;color:rgba(255,255,255,.42);font:700 .46rem/1 monospace;letter-spacing:.105em;text-transform:uppercase}
  .header-designer-stage__selected strong{display:block;overflow:hidden;color:#fff;font:800 clamp(1.35rem,4.8vw,2rem)/.92 var(--font-heading-family);letter-spacing:-.045em;text-transform:uppercase;text-overflow:ellipsis;white-space:nowrap}
  .header-designer-stage__product{display:block;max-width:26rem;margin-top:.35rem;overflow:hidden;color:rgba(255,255,255,.5);font-size:.65rem;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}
  .header-designer-stage__shop{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:.55rem .65rem;background:var(--sp-paradise)!important;border:1px solid var(--sp-paradise)!important;border-radius:0!important;color:var(--sp-deep-sea)!important;font:800 .49rem/1 monospace;letter-spacing:.075em;text-decoration:none;text-transform:uppercase;white-space:nowrap}
  .header-designer-stage__footer{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.72rem .78rem}
  .header-designer-stage__footer span{color:rgba(255,255,255,.34);font:700 .46rem/1 monospace;letter-spacing:.08em;text-transform:uppercase}
  .header-designer-stage__explore{appearance:none;display:inline-flex;align-items:center;min-height:36px;padding:0;background:transparent!important;border:0!important;border-radius:0!important;box-shadow:none!important;color:var(--sp-paradise)!important;font:800 .5rem/1 monospace;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
  @keyframes sp-designer-stage-marquee{to{transform:translateX(-50%)}}
  @media(max-width:749px){.header-drawer__designers--stage{padding-inline:1rem}.header-designer-stage{min-height:318px}.header-designer-stage__selected{grid-template-columns:1fr;align-items:start;gap:.65rem}.header-designer-stage__shop{justify-self:start}.header-designer-stage__footer{align-items:flex-start;flex-direction:column;gap:.45rem}.header-designer-stage__brand{font-size:clamp(1rem,5.1vw,1.28rem)}}
  @media(prefers-reduced-motion:reduce){.header-designer-stage__track{animation:none!important}.header-designer-stage__media-item,.header-designer-stage__brand{transition:none!important}}
{%- endstyle -%}

{%- comment -%}
  Kinetic designer preview for the main navigation drawer.
  Shopify Product Vendor remains the source of truth; the full roster lives in
  the secondary Designer Explorer panel.
{%- endcomment -%}
{%- if section.settings.show_designer_directory and shop.vendors.size > 0 -%}
  {%- liquid
    assign designer_exclusions_raw = section.settings.designer_exclusions | default: 'Other'
    assign designer_exclusions = designer_exclusions_raw | split: ','
    assign visible_designer_count = 0
    assign designer_preview_limit = section.settings.designer_preview_limit | default: 6

    for vendor in shop.vendors
      assign vendor_is_excluded = false
      assign vendor_handle = vendor | handleize
      for excluded_vendor in designer_exclusions
        assign excluded_vendor_handle = excluded_vendor | strip | handleize
        if excluded_vendor_handle != blank and excluded_vendor_handle == vendor_handle
          assign vendor_is_excluded = true
          break
        endif
      endfor
      unless vendor_is_excluded or vendor == blank
        assign visible_designer_count = visible_designer_count | plus: 1
      endunless
    endfor

    assign designer_stage_count = visible_designer_count | at_most: designer_preview_limit
  -%}

  {%- if visible_designer_count > 0 -%}
    <div class="header-drawer__designers header-drawer__designers--stage" aria-labelledby="HeaderDrawerDesigners-{{ section.id }}">
      <div class="header-drawer__shop-head header-drawer__designers-head">
        <p id="HeaderDrawerDesigners-{{ section.id }}">{{ section.settings.designer_directory_label | default: 'Shop by designer' | escape }}</p>
        <span class="header-designer-stage__count">{{ visible_designer_count }} labels</span>
      </div>

      <div class="header-designer-stage" data-designer-stage>
        <div class="header-designer-stage__media" aria-hidden="true">
          {%- liquid
            assign preview_rendered = 0
            assign stage_first_vendor_name = ''
            assign stage_first_vendor_url = ''
            assign stage_first_product_title = 'Current inventory'
          -%}
          {%- for vendor in shop.vendors -%}
            {%- liquid
              assign vendor_is_excluded = false
              assign vendor_handle = vendor | handleize
              for excluded_vendor in designer_exclusions
                assign excluded_vendor_handle = excluded_vendor | strip | handleize
                if excluded_vendor_handle != blank and excluded_vendor_handle == vendor_handle
                  assign vendor_is_excluded = true
                  break
                endif
              endfor
            -%}

            {%- unless vendor_is_excluded or vendor == blank -%}
              {%- if preview_rendered < designer_preview_limit -%}
                {%- liquid
                  assign encoded_vendor = vendor | url_encode
                  assign vendor_url = '/collections/vendors?q=' | append: encoded_vendor | append: '&sort_by=created-descending'
                  assign featured_product = blank
                  assign featured_product_title = 'Current inventory'
                  for product in collections.all.products limit: 50
                    if product.available and product.vendor == vendor
                      assign featured_product = product
                      assign featured_product_title = product.title
                      break
                    endif
                  endfor

                  if preview_rendered == 0
                    assign stage_first_vendor_name = vendor
                    assign stage_first_vendor_url = vendor_url
                    assign stage_first_product_title = featured_product_title
                  endif
                  assign stage_item_number = preview_rendered | plus: 1
                -%}
                <div
                  class="header-designer-stage__media-item{% if preview_rendered == 0 %} is-active{% endif %}"
                  data-designer-stage-media="{{ vendor_handle }}"
                  data-designer-name="{{ vendor | escape }}"
                  data-designer-url="{{ vendor_url | escape }}"
                  data-designer-product="{{ featured_product_title | escape }}"
                  data-designer-index="{{ stage_item_number }}"
                  data-designer-total="{{ designer_stage_count }}"
                >
                  {%- if featured_product != blank and featured_product.featured_image -%}
                    {{ featured_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,560,760,900', sizes: '(max-width: 749px) 100vw, 560px', alt: '' }}
                  {%- else -%}
                    <span class="header-designer-stage__media-fallback">{{ vendor | escape }}</span>
                  {%- endif -%}
                </div>
                {%- assign preview_rendered = preview_rendered | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>

        <div class="header-designer-stage__topline">
          <span>Select a label</span>
          <span data-designer-stage-index>01 / {{ designer_stage_count }}</span>
        </div>

        <div class="header-designer-stage__watermark" data-designer-stage-watermark aria-hidden="true">{{ stage_first_vendor_name | escape }}</div>

        <div class="header-designer-stage__reels" aria-label="Featured designers">
          {%- for stage_row in (1..2) -%}
            <div class="header-designer-stage__reel{% if stage_row == 2 %} header-designer-stage__reel--reverse{% endif %}">
              <div class="header-designer-stage__track">
                {%- for stage_copy in (1..2) -%}
                  {%- assign preview_rendered = 0 -%}
                  {%- for vendor in shop.vendors -%}
                    {%- liquid
                      assign vendor_is_excluded = false
                      assign vendor_handle = vendor | handleize
                      for excluded_vendor in designer_exclusions
                        assign excluded_vendor_handle = excluded_vendor | strip | handleize
                        if excluded_vendor_handle != blank and excluded_vendor_handle == vendor_handle
                          assign vendor_is_excluded = true
                          break
                        endif
                      endfor
                    -%}
                    {%- unless vendor_is_excluded or vendor == blank -%}
                      {%- if preview_rendered < designer_preview_limit -%}
                        <button
                          type="button"
                          class="header-designer-stage__brand{% if preview_rendered == 0 %} is-active{% endif %}"
                          data-designer-stage-brand="{{ vendor_handle }}"
                          aria-pressed="{% if preview_rendered == 0 %}true{% else %}false{% endif %}"
                          {% unless stage_row == 1 and stage_copy == 1 %}tabindex="-1"{% endunless %}
                        >{{ vendor | escape }}</button>
                        {%- assign preview_rendered = preview_rendered | plus: 1 -%}
                      {%- endif -%}
                    {%- endunless -%}
                  {%- endfor -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="header-designer-stage__selected" aria-live="polite">
          <div class="header-designer-stage__selected-copy">
            <span class="header-designer-stage__eyebrow">Current designer</span>
            <strong data-designer-stage-name>{{ stage_first_vendor_name | escape }}</strong>
            <span class="header-designer-stage__product" data-designer-stage-product>{{ stage_first_product_title | escape }}</span>
          </div>
          <a class="header-designer-stage__shop" data-designer-stage-shop href="{{ stage_first_vendor_url | escape }}">Shop {{ stage_first_vendor_name | escape }} →</a>
        </div>

        <div class="header-designer-stage__footer">
          <span>Vendor-powered · updates with inventory</span>
          <button
            type="button"
            class="header-designer-stage__explore"
            data-header-explorer-open="designers"
            aria-controls="HeaderDesignerExplorer-{{ section.id }}"
          >Explore all {{ visible_designer_count }} designers →</button>
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

<script>
(function(){
  function initStage(stage){
    if(!stage || stage.dataset.designerStageInitialized === 'true') return;
    var buttons = stage.querySelectorAll('[data-designer-stage-brand]');
    var mediaItems = stage.querySelectorAll('[data-designer-stage-media]');
    if(!buttons.length || !mediaItems.length) return;
    stage.dataset.designerStageInitialized = 'true';
    var nameTarget = stage.querySelector('[data-designer-stage-name]');
    var productTarget = stage.querySelector('[data-designer-stage-product]');
    var shopTarget = stage.querySelector('[data-designer-stage-shop]');
    var indexTarget = stage.querySelector('[data-designer-stage-index]');
    var watermarkTarget = stage.querySelector('[data-designer-stage-watermark]');

    function activate(handle){
      var media = null;
      for(var i=0;i<mediaItems.length;i+=1){
        if(mediaItems[i].getAttribute('data-designer-stage-media') === handle){media = mediaItems[i];break;}
      }
      if(!media) return;
      var name = media.getAttribute('data-designer-name') || 'Designer';
      var url = media.getAttribute('data-designer-url') || '#';
      var product = media.getAttribute('data-designer-product') || 'Current inventory';
      var index = String(media.getAttribute('data-designer-index') || '1').padStart(2,'0');
      var total = String(media.getAttribute('data-designer-total') || mediaItems.length).padStart(2,'0');
      for(var j=0;j<mediaItems.length;j+=1){mediaItems[j].classList.toggle('is-active',mediaItems[j]===media);}
      for(var k=0;k<buttons.length;k+=1){
        var active = buttons[k].getAttribute('data-designer-stage-brand') === handle;
        buttons[k].classList.toggle('is-active',active);
        buttons[k].setAttribute('aria-pressed',active?'true':'false');
      }
      if(nameTarget) nameTarget.textContent = name;
      if(productTarget) productTarget.textContent = product;
      if(watermarkTarget) watermarkTarget.textContent = name;
      if(indexTarget) indexTarget.textContent = index + ' / ' + total;
      if(shopTarget){shopTarget.href=url;shopTarget.textContent='Shop '+name+' →';shopTarget.setAttribute('aria-label','Shop '+name);}
    }

    for(var b=0;b<buttons.length;b+=1){
      (function(button){
        var handle = button.getAttribute('data-designer-stage-brand');
        button.addEventListener('mouseenter',function(){activate(handle);});
        button.addEventListener('focus',function(){activate(handle);});
        button.addEventListener('click',function(){activate(handle);});
        button.addEventListener('pointerdown',function(){activate(handle);},{passive:true});
      })(buttons[b]);
    }
    var initial = stage.querySelector('[data-designer-stage-media].is-active') || mediaItems[0];
    activate(initial.getAttribute('data-designer-stage-media'));
  }
  function initAll(scope){
    var root = scope || document;
    if(root.matches && root.matches('[data-designer-stage]')) initStage(root);
    var stages = root.querySelectorAll ? root.querySelectorAll('[data-designer-stage]') : [];
    for(var i=0;i<stages.length;i+=1) initStage(stages[i]);
  }
  initAll(document);
  if(!window.__spDesignerStageFallbackBound){
    window.__spDesignerStageFallbackBound = true;
    document.addEventListener('shopify:section:load',function(event){initAll(event.target);});
  }
})();
</script>
