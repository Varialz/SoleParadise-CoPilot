{%- comment -%}
  Canonical Sole Paradise product summary card.
  Product photography stays primary. Resale/archive metadata is intentionally quiet and secondary.
{%- endcomment -%}
{%- liquid
  assign card_heading_tag = heading_tag
  unless card_heading_tag == 'h2' or card_heading_tag == 'h3' or card_heading_tag == 'h4'
    assign card_heading_tag = 'h3'
  endunless
  assign card_image_loading = image_loading
  unless card_image_loading == 'eager' or card_image_loading == 'lazy'
    assign card_image_loading = 'lazy'
  endunless
  assign card_fetch_priority = fetch_priority
  unless card_fetch_priority == 'high' or card_fetch_priority == 'low' or card_fetch_priority == 'auto'
    assign card_fetch_priority = 'auto'
  endunless
  assign card_image_sizes = image_sizes | default: '100vw'
  assign image_widths = '240,360,480,640,800,960'
  assign card_show_vendor = true
  if show_vendor == false
    assign card_show_vendor = false
  endif
  assign card_show_badges = true
  if show_badges == false
    assign card_show_badges = false
  endif
-%}

{%- if product == blank -%}
  <article class="product-card product-card--placeholder" data-sp-reveal>
    <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}</div>
    <div class="product-card__information">
      <{{ card_heading_tag }} class="product-card__title">{{ 'products.card.placeholder_title' | t }}</{{ card_heading_tag }}>
    </div>
  </article>
{%- else -%}
  {%- liquid
    if collection != blank
      assign product_url = product.url | within: collection
    else
      assign product_url = product.url
    endif

    assign featured_image = product.featured_image
    assign secondary_image = product.images[1]
    assign image_alt = ''
    if featured_image.alt != blank and featured_image.alt != product.title
      assign image_alt = featured_image.alt
    endif

    assign on_sale = false
    if product.available
      for variant in product.variants
        if variant.available and variant.compare_at_price > variant.price
          assign on_sale = true
          break
        endif
      endfor
    endif

    assign render_secondary_image = false
    if show_secondary_image == true and secondary_image != blank
      assign render_secondary_image = true
    endif

    assign from_feed = false
    if product.tags contains 'FROM-FEED'
      assign from_feed = true
    endif

    assign item_state = product.metafields.custom.item_state.value | default: product.metafields.custom.item_state
    assign archive_size = product.metafields.custom.size.value | default: product.metafields.custom.size
    assign condition = product.metafields.custom.condition.value | default: product.metafields.custom.condition
    assign archive_id = product.metafields.custom.archive_id.value | default: product.metafields.custom.archive_id

    if archive_size == 0 or archive_size == '0'
      assign archive_size = ''
    endif

    assign size_option_position = 0
    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name contains 'size'
        assign size_option_position = option.position
        break
      endif
    endfor

    assign available_card_sizes = ''
    assign seen_card_sizes = '|'
    if size_option_position > 0
      for variant in product.variants
        if variant.available
          assign variant_size = ''
          case size_option_position
            when 1
              assign variant_size = variant.option1
            when 2
              assign variant_size = variant.option2
            when 3
              assign variant_size = variant.option3
          endcase

          if variant_size != blank and variant_size != 'Default Title'
            assign size_token = '|' | append: variant_size | append: '|'
            unless seen_card_sizes contains size_token
              if available_card_sizes != blank
                assign available_card_sizes = available_card_sizes | append: ' · '
              endif
              assign available_card_sizes = available_card_sizes | append: variant_size
              assign seen_card_sizes = seen_card_sizes | append: variant_size | append: '|'
            endunless
          endif
        endif
      endfor
    endif

    assign card_catalog_signal = product.type | append: ' ' | append: product.title | append: ' ' | append: product.tags | downcase | replace: '-', ' ' | replace: '_', ' ' | replace: '/', ' ' | prepend: ' ' | append: ' '
    assign card_is_accessory = false
    if card_catalog_signal contains ' accessory ' or card_catalog_signal contains ' accessories ' or card_catalog_signal contains ' bag ' or card_catalog_signal contains ' wallet ' or card_catalog_signal contains ' belt ' or card_catalog_signal contains ' jewelry ' or card_catalog_signal contains ' jewellery ' or card_catalog_signal contains ' necklace ' or card_catalog_signal contains ' bracelet ' or card_catalog_signal contains ' ring ' or card_catalog_signal contains ' pendant ' or card_catalog_signal contains ' chain ' or card_catalog_signal contains ' sunglasses ' or card_catalog_signal contains ' glasses ' or card_catalog_signal contains ' eyewear ' or card_catalog_signal contains ' keychain ' or card_catalog_signal contains ' hat ' or card_catalog_signal contains ' cap ' or card_catalog_signal contains ' beanie '
      assign card_is_accessory = true
    endif

    if archive_size == blank and available_card_sizes == blank and card_is_accessory and product.available
      assign available_card_sizes = 'OS'
    endif

    assign card_size_prefix = 'Sizes'
    unless available_card_sizes contains ' · '
      assign card_size_prefix = 'Size'
    endunless

    assign has_archive_meta = false
    if archive_size != blank or condition != blank or item_state != blank or archive_id != blank
      assign has_archive_meta = true
    endif

    assign quick_view_image = ''
    if featured_image != blank
      assign quick_view_image = featured_image | image_url: width: 1200
    endif
  -%}

  <article class="product-card{% if from_feed %} product-card--archive{% endif %}" data-sp-reveal>
    <div class="product-card__media{% if render_secondary_image %} product-card__media--has-secondary{% endif %}">
      {%- if card_show_badges -%}
        {%- unless product.available -%}
          <span class="product-card__badge product-card__badge--sold-out">{{ 'products.card.sold_out' | t }}</span>
        {%- else -%}
          {%- if on_sale -%}<span class="product-card__badge product-card__badge--sale">{{ 'products.card.sale' | t }}</span>{%- endif -%}
        {%- endunless -%}
      {%- endif -%}

      {%- if from_feed and archive_id != blank -%}
        <span class="product-card__provenance" aria-label="Archive reference">
          {{ archive_id | escape }}
        </span>
      {%- endif -%}

      {%- if featured_image != blank -%}
        {{ featured_image | image_url: width: 960 | image_tag: loading: card_image_loading, fetchpriority: card_fetch_priority, sizes: card_image_sizes, widths: image_widths, class: 'product-card__image product-card__image--primary', alt: image_alt }}
        {%- if render_secondary_image -%}
          {{ secondary_image | image_url: width: 960 | image_tag: loading: 'lazy', sizes: card_image_sizes, widths: image_widths, class: 'product-card__image product-card__image--secondary', alt: '' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}
      {%- endif -%}

      <button
        class="product-card__quick-view no-js-hidden"
        type="button"
        data-quick-view-trigger
        data-product-url="{{ product.url | escape }}"
        data-preview-title="{{ product.title | escape }}"
        data-preview-vendor="{{ product.vendor | escape }}"
        data-preview-price="{{ product.price | money | escape }}"
        {% if quick_view_image != blank %}data-preview-image="{{ quick_view_image | escape }}"{% endif %}
        data-archive="{% if from_feed %}true{% else %}false{% endif %}"
        {% if archive_id != blank %}data-archive-id="{{ archive_id | escape }}"{% endif %}
        {% if archive_size != blank %}data-size="{{ archive_size | escape }}"{% elsif available_card_sizes != blank %}data-size="{{ available_card_sizes | escape }}"{% endif %}
        {% if condition != blank %}data-condition="{{ condition | escape }}"{% endif %}
        {% if item_state != blank %}data-item-state="{{ item_state | escape }}"{% endif %}
        aria-label="Quick view {{ product.title | escape }}"
        aria-haspopup="dialog"
        aria-controls="SoleParadiseQuickView"
      >Quick view</button>
    </div>

    <div class="product-card__information">
      {%- if card_show_vendor and product.vendor != blank -%}<p class="product-card__vendor">{{ product.vendor | escape }}</p>{%- endif -%}
      <{{ card_heading_tag }} class="product-card__title"><a class="product-card__link" href="{{ product_url | escape }}">{{ product.title | escape }}</a></{{ card_heading_tag }}>

      {%- if has_archive_meta -%}
        <p class="product-card__archive-meta" aria-label="Piece details">
          {%- if archive_size != blank -%}<span>{{ archive_size | escape }}</span>{%- endif -%}
          {%- if condition != blank -%}<span>{{ condition | escape }}</span>{%- endif -%}
          {%- if item_state != blank -%}<span>{{ item_state | escape }}</span>{%- endif -%}
        </p>
      {%- endif -%}

      {%- if archive_size == blank and available_card_sizes != blank -%}
        <p class="product-card__archive-meta product-card__size-meta" aria-label="Available sizes">
          <span>{{ card_size_prefix }} {{ available_card_sizes | escape }}</span>
        </p>
      {%- endif -%}

      {%- render 'product-price', product: product -%}
      <p class="product-card__trust" aria-label="Store assurances"><span>Authenticated</span><span>Chicago</span></p>
      {%- if settings.show_temporary_fulfillment and product.available -%}
        <p class="product-card__fulfillment" aria-label="Fulfillment options">
          <span>{{ settings.same_day_delivery_text | escape }}</span>
          <span>{{ settings.pickup_today_text | escape }}</span>
        </p>
      {%- endif -%}
    </div>
  </article>
{%- endif -%}
