{%- comment -%}Native accordions stay usable without JavaScript. Vendors follow the live catalog.{%- endcomment -%}
{%- liquid
  assign contact_page_url = pages['contact'].url | default: '/pages/contact'
  assign faq_menu_url = section.settings.faq_menu_link | default: pages['faq'].url | default: pages['faqs'].url
  if faq_menu_url == blank
    assign faq_menu_url = contact_page_url | append: '?view=faq'
  endif
  assign refund_menu_url = section.settings.refund_menu_link
  if refund_menu_url == blank
    capture refund_menu_url
      render 'refund-policy-url'
    endcapture
  endif
  assign collectibles_menu_url = section.settings.collectibles_menu_link | default: collections['collectibles'].url
  assign jewelry_menu_url = section.settings.jewelry_menu_link | default: collections['jewelry'].url | default: collections['jewellery'].url
  assign womens_menu_url = section.settings.womens_menu_link | default: collections['womens'].url | default: collections['women'].url
  for link in menu.links
    assign link_key = link.title | handleize
    if collectibles_menu_url == blank and link_key == 'collectibles'
      assign collectibles_menu_url = link.url
    elsif jewelry_menu_url == blank
      if link_key == 'jewelry' or link_key == 'jewellery'
        assign jewelry_menu_url = link.url
      endif
    endif
    if womens_menu_url == blank
      if link_key == 'womens' or link_key == 'women-s' or link_key == 'women'
        assign womens_menu_url = link.url
      endif
    endif
  endfor
  if collectibles_menu_url == blank
    assign collectibles_menu_url = routes.search_url | append: '?q=collectible*&type=product'
  endif
  if jewelry_menu_url == blank
    assign jewelry_menu_url = routes.search_url | append: '?q=jewelry+OR+jewellery+OR+necklace+OR+bracelet+OR+ring+OR+pendant+OR+earrings&type=product'
  endif
  if womens_menu_url == blank
    assign womens_menu_url = routes.search_url | append: '?q=women*&type=product'
  endif
  assign arrivals_menu_url = routes.all_products_collection_url | append: '?sort_by=created-descending'
  assign sale_menu_url = section.settings.sale_menu_link
  if sale_menu_url == blank
    assign sale_menu_url = routes.collections_url | append: '/sale'
    for link in menu.links
      assign link_key = link.title | handleize
      if link_key == 'sale'
        assign sale_menu_url = link.url
        break
      endif
    endfor
  endif
-%}
<a class="sp-menu-group-link" href="{{ arrivals_menu_url | escape }}">New Arrivals</a>
<a class="sp-menu-group-link" href="{{ sale_menu_url | escape }}">Sale</a>
{%- if section.settings.show_designer_directory and shop.vendors.size > 0 -%}
  <details class="sp-menu-group">
    <summary>Brands <span class="sp-menu-toggle" aria-hidden="true"></span></summary>
    <ul class="sp-menu-links" role="list">
      {%- assign exclusions = section.settings.designer_exclusions | default: 'Other' | split: ',' -%}
      {%- for vendor in shop.vendors -%}
        {%- liquid
          assign excluded = false
          assign vendor_key = vendor | handleize
          for exclusion in exclusions
            assign exclusion_key = exclusion | strip | handleize
            if exclusion_key == vendor_key
              assign excluded = true
              break
            endif
          endfor
        -%}
        {%- unless excluded or vendor == blank -%}
          <li><a href="{{ vendor | url_for_vendor | escape }}">{{ vendor | escape }}</a></li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </details>
{%- endif -%}
<details class="sp-menu-group">
  <summary>Category <span class="sp-menu-toggle" aria-hidden="true"></span></summary>
  <div class="sp-menu-children">
    <details class="sp-menu-subgroup">
      <summary>Tops <span class="sp-menu-toggle" aria-hidden="true"></span></summary>
      <ul class="sp-menu-links" role="list">
        <li><a href="{{ routes.search_url }}?q=tee&amp;type=product">T-shirts</a></li>
        <li><a href="{{ routes.search_url }}?q=hoodie&amp;type=product">Hoodies</a></li>
        <li><a href="{{ routes.search_url }}?q=sweatshirt&amp;type=product">Sweatshirts</a></li>
        <li><a href="{{ routes.search_url }}?q=jacket&amp;type=product">Jackets</a></li>
      </ul>
    </details>
    <details class="sp-menu-subgroup">
      <summary>Bottoms <span class="sp-menu-toggle" aria-hidden="true"></span></summary>
      <ul class="sp-menu-links" role="list">
        <li><a href="{{ routes.search_url }}?q=denim&amp;type=product">Denim</a></li>
        <li><a href="{{ routes.search_url }}?q=pants&amp;type=product">Pants</a></li>
        <li><a href="{{ routes.search_url }}?q=shorts&amp;type=product">Shorts</a></li>
      </ul>
    </details>
    <a class="sp-menu-child-link" href="{{ routes.search_url }}?q=accessories&amp;type=product">Accessories</a>
    <a class="sp-menu-child-link" href="{{ routes.search_url }}?q=shoes&amp;type=product">Footwear</a>
    <a class="sp-menu-child-link" href="{{ routes.all_products_collection_url }}">Shop all</a>
  </div>
</details>
<a class="sp-menu-group-link" href="{{ collectibles_menu_url | escape }}">Collectibles</a>
<a class="sp-menu-group-link" href="{{ jewelry_menu_url | escape }}">Jewelry</a>
<a class="sp-menu-group-link" href="{{ womens_menu_url | escape }}">Womens</a>
{%- comment -%}Keep the store's configured navigation, including its nested links.{%- endcomment -%}
{%- if menu != blank -%}
  {%- for link in menu.links -%}
    {%- assign link_key = link.title | handleize -%}
    {%- if link_key == 'new-arrivals' or link_key == 'sale' or link_key == 'collectibles' or link_key == 'jewelry' or link_key == 'jewellery' or link_key == 'womens' or link_key == 'women-s' or link_key == 'women' or link_key == 'faq' or link_key == 'faqs' or link_key == 'refund-policy' -%}{%- continue -%}{%- endif -%}
    {%- if link.links.size > 0 -%}
      <details class="sp-menu-group">
        <summary>{{ link.title | escape }} <span class="sp-menu-toggle" aria-hidden="true"></span></summary>
        <div class="sp-menu-children">
          <a class="sp-menu-child-link" href="{{ link.url | escape }}">Shop all {{ link.title | escape }}</a>
          {%- for child in link.links -%}
            {%- if child.links.size > 0 -%}
              <details class="sp-menu-subgroup">
                <summary>{{ child.title | escape }} <span class="sp-menu-toggle" aria-hidden="true"></span></summary>
                <ul class="sp-menu-links" role="list">
                  <li><a href="{{ child.url | escape }}">Shop all {{ child.title | escape }}</a></li>
                  {%- for grandchild in child.links -%}
                    <li><a href="{{ grandchild.url | escape }}"{% if grandchild.active %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="sp-menu-child-link" href="{{ child.url | escape }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </details>
    {%- else -%}
      <a class="sp-menu-group-link" href="{{ link.url | escape }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  <a class="sp-menu-group-link" href="{{ routes.all_products_collection_url }}">Shop all</a>
  <a class="sp-menu-group-link" href="/pages/contact">Contact</a>
{%- endif -%}
<a class="sp-menu-group-link" href="https://waitwhile.com/locations/soleparadise" target="_blank" rel="noopener">Reservations <span aria-hidden="true">↗</span></a>

<a class="sp-menu-group-link" href="{{ faq_menu_url | escape }}">FAQ</a>
<a class="sp-menu-group-link" href="{{ refund_menu_url | escape }}">Refund Policy</a>
