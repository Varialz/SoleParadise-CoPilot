{%- liquid
  assign size = size | default: 24
  assign stroke_width = stroke_width | default: 1.75
  case name
    when 'menu'
      assign inner = '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>'
    when 'close'
      assign inner = '<line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/>'
    when 'search'
      assign inner = '<circle cx="10.5" cy="10.5" r="6.5"/><line x1="15.3" y1="15.3" x2="21" y2="21"/>'
    when 'account'
      assign inner = '<circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c1.4-4.2 5-5.8 7.5-5.8s6.1 1.6 7.5 5.8"/>'
    when 'bag'
      assign inner = '<path d="M6.5 8h11l1 12h-13l1-12z"/><path d="M9 8V6.5a3 3 0 016 0V8"/>'
    when 'chevron-down'
      assign inner = '<polyline points="6 9 12 15 18 9"/>'
    when 'arrow-right'
      assign inner = '<line x1="4" y1="12" x2="18" y2="12"/><polyline points="12 6 18 12 12 18"/>'
    when 'play'
      assign inner = '<circle cx="12" cy="12" r="9"/><path d="M10.2 8.6l5.4 3.4-5.4 3.4V8.6z"/>'
    when 'model'
      assign inner = '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M4 7.5l8 4.5 8-4.5"/><line x1="12" y1="12" x2="12" y2="21"/>'
    when 'package'
      assign inner = '<path d="M4 7.5L12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>'
    when 'phone'
      assign inner = '<path d="M7.2 3.5l2.2 4.2-2 1.6c1 2.3 3 4.3 5.3 5.3l1.6-2 4.2 2.2-.7 4c-.2 1-1.2 1.7-2.2 1.5C9.3 19.2 4.8 14.7 3.7 8.4c-.2-1 .5-2 1.5-2.2l2-.7z"/>'
    when 'lock'
      assign inner = '<rect x="5" y="10" width="14" height="11"/><path d="M8 10V7a4 4 0 018 0v3"/><circle cx="12" cy="15" r="1"/>'
    when 'mail'
      assign inner = '<rect x="3" y="5" width="18" height="14"/><path d="M3 7l9 6 9-6"/>'
    when 'store'
      assign inner = '<path d="M4 10v10h16V10M3 9l2-5h14l2 5"/><path d="M3 9a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0M9 20v-6h6v6"/>'
    when 'instagram'
      assign inner = '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"/>'
    when 'facebook'
      assign inner = '<path d="M15 8.5h-2c-.4 0-.7.3-.7.8v2h2.6l-.4 2.6h-2.2V21h-2.7v-7.1H9.5v-2.6h2.1V9.1c0-2.1 1.3-3.6 3.6-3.6H15v3z" fill="currentColor" stroke="none"/>'
    when 'tiktok'
      assign inner = '<path d="M16.6 3.5c.4 1.9 1.7 3.2 3.5 3.5v2.6c-1.3 0-2.5-.4-3.5-1.1v6.3a5.4 5.4 0 11-4.7-5.35v2.7a2.7 2.7 0 102.2 2.65V3.5h2.5z" fill="currentColor" stroke="none"/>'
    else
      assign inner = ''
  endcase
-%}
{%- if inner != '' -%}<svg class="icon icon--{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke_width }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ inner }}</svg>{%- endif -%}
