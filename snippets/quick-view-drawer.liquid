<div class="sp-quick-view" id="SoleParadiseQuickView" data-quick-view hidden>
  <button class="sp-quick-view__backdrop" type="button" data-quick-view-close aria-label="Close quick shop"></button>

  <aside class="sp-quick-view__panel" role="dialog" aria-modal="true" aria-labelledby="QuickViewTitle" data-quick-view-panel tabindex="-1">
    <div class="sp-quick-view__handle" aria-hidden="true"></div>

    <header class="sp-quick-view__header">
      <span class="sp-quick-view__label">Quick shop</span>
      <button class="sp-quick-view__close" type="button" data-quick-view-close aria-label="Close quick shop">×</button>
    </header>

    <div class="sp-quick-view__body" data-quick-view-body>
      <div class="sp-quick-view__loading" data-quick-view-loading role="status" aria-live="polite">
        <span></span><span></span><span></span>
        <p>Loading piece…</p>
      </div>

      <div class="sp-quick-view__content" data-quick-view-content hidden>
        <div class="sp-quick-view__media">
          <div class="sp-quick-view__image-wrap">
            <img class="sp-quick-view__image" data-quick-view-image src="" alt="">
            <span class="sp-quick-view__image-index" data-quick-view-image-index>01 / 01</span>
          </div>
          <div class="sp-quick-view__thumbs" data-quick-view-thumbs></div>
        </div>

        <div class="sp-quick-view__details">
          <div class="sp-quick-view__identity">
            <p class="sp-quick-view__vendor" data-quick-view-vendor></p>
            <h2 class="sp-quick-view__title" id="QuickViewTitle" data-quick-view-title></h2>
            <p class="sp-quick-view__price" data-quick-view-price></p>
          </div>

          <div class="sp-quick-view__archive" data-quick-view-archive-block hidden>
            <span data-quick-view-archive-id>1 of 1</span>
            <div data-quick-view-meta></div>
          </div>

          <div class="sp-quick-view__variants" data-quick-view-variants hidden>
            <div class="sp-quick-view__variants-head">
              <span>Choose size / option</span>
              <span data-quick-view-selected-variant></span>
            </div>
            <div class="sp-quick-view__variant-options" data-quick-view-variant-options></div>
            <select class="visually-hidden" id="QuickViewVariant" data-quick-view-variant-select aria-label="Choose size or option"></select>
          </div>

          <div class="sp-quick-view__actions">
            <button class="sp-quick-view__add" type="button" data-quick-view-add>Choose a size</button>
            <p class="sp-quick-view__status" data-quick-view-status role="status" aria-live="polite"></p>
            <div class="sp-quick-view__action-links">
              <a class="sp-quick-view__full-link" href="#" data-quick-view-full-link>Product details</a>
              <a class="sp-quick-view__bag-link" href="{{ routes.cart_url }}" data-quick-view-bag-link hidden>View bag →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="sp-quick-view__error" data-quick-view-error hidden>
        <p>Couldn’t load this piece.</p>
        <a class="sp-quick-view__error-link" href="#" data-quick-view-error-link>Open product page →</a>
      </div>
    </div>
  </aside>
</div>
